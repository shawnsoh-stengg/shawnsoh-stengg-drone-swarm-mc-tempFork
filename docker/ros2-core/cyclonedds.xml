<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS domain configuration for drone-mc containers (INFRA-004).
  Deployed to /etc/drone-mc/cyclonedds.xml — bind-mounted read-only into
  every service container (SDD §12.5, ICD §9.4).

  Same-host only. This config's scope is deliberately narrow: it covers
  discovery between containers on one drone's Jetson (all run in host
  network mode, so they share one loopback interface and discover each
  other over lo). It does NOT reach across the MANET link to peer MCs or
  the GCS — that job now belongs to zenoh-bridge-dds
  (config/zenoh-bridge-dds.json5, docker/zenoh-bridge/), which bridges
  selected DDS topics over a static-peer Zenoh mesh instead of relying on
  CycloneDDS's own discovery protocol across a bandwidth-constrained,
  lossy link. This split replaces the old approach of extending
  CycloneDDS's own unicast Peers list with every other drone's eth0
  address — see zenoh-bridge-dds.json5's connect/listen endpoints for
  where that per-drone peer list now lives.

  Discovery is unicast-only on lo. AllowMulticast=false plus an explicit
  Discovery/Peers list of 127.0.0.1 keeps discovery to this host's own
  participants; nothing here ever touches eth0.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config
              https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <Interfaces>
        <!-- Same-host container-to-container discovery (host network mode). -->
        <NetworkInterface name="lo" priority="default" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>4096B</FragmentSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <!-- Enough slots for all same-host nodes + a few extras for tooling. -->
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <!-- Multicast is off, so SPDP only finds participants on this host. -->
      <Peers>
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <SocketSendBufferSize min="1MB"/>
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
