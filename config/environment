# /etc/drone-mc/environment — default deployment environment variables.
# Bind-mounted read-only into every drone-mc Docker container (SDD §12.2).
# Edit per-drone values (DRONE_ID, MC_VERSION, FCC_TRANSPORT) before
# starting drone-mc.target on each vehicle.

# --- Drone identity ---
DRONE_ID=1
MC_VERSION=dev

# --- MC's own network identity (INFRA-008) ---
# Per-drone: unique per physical unit. Rendered into
# config/netplan/01-drone-mc.yaml's ${MC_ETH_MAC}/${MC_ETH_IP} placeholders
# by scripts/01-install-os.sh — edit these two values (and re-run that
# script) rather than hand-editing the rendered /etc/netplan/01-drone-mc.yaml
# when provisioning a new unit. eth0 has this single address: the MANET/GCS
# peers and this drone's own Pixhawk all share the 192.168.10.x subnet
# (HID-MC-001 §4.2).
MC_ETH_MAC=4c:bb:47:c4:2d:6e
MC_ETH_IP=192.168.10.11

# --- FCC transport (SDD §3, ICD §9.4) ---
# serial: ttyTHS1 via uXRCE-DDS (production default, HID §HIF-001)
# ethernet: UDP to FCC_ETH_IP (fallback, HID §HIF-002)
FCC_TRANSPORT=serial
FCC_SERIAL_DEVICE=/dev/ttyTHS1
FCC_SERIAL_BAUD=921600
FCC_ETH_PORT=8888

# This drone's own Pixhawk's single Ethernet address (per-drone,
# INFRA-008) — the only FCC address. PX4's NuttX network stack gives the
# Pixhawk exactly one IPv4 address (/fs/microsd/net.cfg IPADDR, `netman
# show`), so every MC<->FCC Ethernet channel targets it: the uXRCE-DDS
# fallback above, the mission protocol, the optical-flow relay, the HIL_GPS
# sender, and mavlink-router-channel-a.conf's Channel A pass-through. (Until
# 2026-09-25 the FCC was documented as dual-homed on a separate 192.168.12.x
# internal subnet plus a FCC_GCS_IP on 192.168.10.x — never true of real
# hardware; the orin-nx bench Pixhawk only answered on 192.168.10.19.)
FCC_ETH_IP=192.168.10.31

# Mission protocol (MAVLink to FCC_ETH_IP, always on — independent of
# FCC_TRANSPORT above; stock PX4 has no DDS-writable mission topic, IR-007)
FCC_MISSION_PORT=14555

# HIF-008 optical-flow relay (MAVLink from FCC_ETH_IP, always on — independent
# of FCC_TRANSPORT above; stock PX4 doesn't bridge sensor_optical_flow/
# distance_sensor to the companion computer over DDS, HID-MC-001 §10 /
# ICD §3.3a)
FCC_FLOW_PORT=14556

# --- GCS (ICD §IFD-002) ---
GCS_IP=192.168.10.10
GCS_MAV_PORT_RECV=14551
GCS_MAV_PORT_SEND=14552
# gcs_mavlink_node's own loopback socket — mavlink-router-channel-b.conf's
# GCS_MAVLINK_NODE endpoint (ICD §4.2), not directly reachable off-box.
GCS_MAVLINK_LOOPBACK_PORT=14560

# --- Swarm (ICD §IFD-003) ---
SWARM_HB_PORT=14900
SWARM_COORD_PORT=14901

# --- Safety thresholds (SRS FR-010, FR-011) ---
LOW_BATTERY_THRESHOLD=0.20
GCS_LINK_TIMEOUT_S=10
FCC_LINK_TIMEOUT_S=1
EXECUTOR_WD_TIMEOUT_S=5

# --- Simulation ---
# Set to true to use MavlinkUdpBackend instead of XrceDdsBackend (SDD §13.1).
SIMULATION_MODE=false
# MavlinkUdpBackend's local bind port when SIMULATION_MODE=true — the peer
# (PX4 SITL) is learned dynamically from the first datagram it sends here,
# not configured by IP (FCC-007). Matches SDD §13.1's documented SITL port.
SITL_FCC_PORT=14540

# --- ROS 2 / DDS ---
ROS_DOMAIN_ID=0
CYCLONEDDS_URI=/etc/drone-mc/cyclonedds.xml

# --- Camera (ICD §IFD-004) ---
CAMERA_CALIBRATION_FILE=/etc/drone-mc/camera_calibration.yaml
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
