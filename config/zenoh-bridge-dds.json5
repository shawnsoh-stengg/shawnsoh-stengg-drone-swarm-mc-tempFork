// zenoh-bridge-dds configuration for drone-mc (SDD §12.4, SRS SW-008).
// Deployed to /etc/drone-mc/zenoh-bridge-dds.json5 — bind-mounted read-only
// into the zenoh-bridge-dds container (config/systemd/drone-mc-zenoh-bridge.service).
//
// This is the cross-host counterpart to docker/ros2-core/cyclonedds.xml,
// which is now same-host (lo) only. Where cyclonedds.xml used to carry an
// eth0 NetworkInterface plus a unicast <Peers> list of every other drone's
// eth0 address, that per-drone peer list now lives here instead, expressed
// as Zenoh connect/listen endpoints. Zenoh's peer-mesh model (static
// locators, no reliance on multicast scouting) is a better fit for the
// MANET link than DDS's own discovery protocol — CycloneDDS still runs
// per-drone, but nothing in it reaches across hosts anymore.
//
// INFRA-008: this file is an envsubst template, not the file installed
// directly — scripts/02-install-systemd-units.sh generates
// ${CONNECT_ENDPOINTS} from config/fleet.yaml (the fleet-wide drone_id ->
// eth0 IP manifest) minus this drone's own DRONE_ID
// (/etc/drone-mc/environment), then renders this file to
// /etc/drone-mc/zenoh-bridge-dds.json5. Adding a new swarm member is: add
// one line to config/fleet.yaml, re-run 02-install-systemd-units.sh on
// every drone (including the new one) — not hand-editing this file or the
// rendered output per drone as before.
//
// SITL/dev: if there are no other hosts on the network (or config/fleet.yaml
// doesn't exist yet), ${CONNECT_ENDPOINTS} renders empty and "connect" is
// left empty (an idle bridge with peer mode and no reachable peers is
// harmless) — all SITL nodes are on one host and never need this bridge.
{
  // Bridges whichever DDS domain this drone's containers use
  // ($ROS_DOMAIN_ID, /etc/drone-mc/environment) — not hardcoded here.
  plugins: {
    dds: {
      // Forward nothing by default. "^$" only matches an empty topic name,
      // which no real DDS topic has — the standard "allow nothing" idiom
      // (the underlying regex engine has no "deny all" primitive of its own).
      // Nothing currently needs cross-host DDS: swarm_coord's peer
      // heartbeat/ISR/Voronoi protocol is a separate custom UDP protocol
      // (ICD IFD-003, ports 14900/14901), not DDS topics. Extend this list
      // once a real cross-host DDS topic exists, e.g.:
      //   allow: ["rt/mc/swarm/.*"]
      allow: ["^$"],
    },
  },

  // Mesh, not a central router — no single point of failure if one drone
  // or the GCS drops off the link.
  mode: "peer",

  // Static peer list instead of UDP multicast scouting — the MANET link
  // (CLAUDE.md Network Reference) is bandwidth-constrained and shared with
  // MAVLink/video traffic, same rationale cyclonedds.xml's AllowMulticast
  // used to document for eth0.
  scouting: { multicast: { enabled: false } },

  // This drone's own peer MCs, generated from config/fleet.yaml (this
  // drone's own address is excluded by construction). A future GCS-side
  // zenoh endpoint, if one is ever stood up, would be added to fleet.yaml
  // the same way — GCS software itself stays out of this repo's scope
  // (SRS §1.4).
  connect: { endpoints: [${CONNECT_ENDPOINTS}] },
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
}
