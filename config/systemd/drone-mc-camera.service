# drone-mc-camera.service — camera_node (gscam2) driving the IMX219 CSI
# sensor. Split out from vision.service (diagram 03) so the lightweight
# capture path can restart independently of the GPU-heavy VO/detection
# pipeline. Installed by scripts/02-install-systemd-units.sh.
[Unit]
Description=Drone MC — Camera (CSI capture)
PartOf=drone-mc.target
After=docker.service drone-mc-health-monitor.service
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Slice=be.slice
EnvironmentFile=/etc/drone-mc/environment
ExecStart=/usr/bin/docker run --rm --name mc-camera \
  --network=host \
  --device /dev/video0 \
  --mount type=bind,src=/opt/drone-mc/install,dst=/opt/drone-mc/install \
  --mount type=bind,src=/etc/drone-mc,dst=/etc/drone-mc,readonly \
  --env-file /etc/drone-mc/environment \
  ghcr.io/drone-mc/camera:${MC_VERSION}
ExecStop=/usr/bin/docker stop mc-camera
Restart=on-failure
RestartSec=5s
MemoryMax=1G
CPUQuota=50%
DeviceAllow=/dev/video0 rw
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=drone-mc.target
