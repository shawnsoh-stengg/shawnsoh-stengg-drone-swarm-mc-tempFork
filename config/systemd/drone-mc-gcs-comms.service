# drone-mc-gcs-comms.service — gcs_mavlink_node (raw-MAVLink GCS<->MC
# channel) + MAVROS (Channel A vehicle-telemetry mirror, GCS-005,
# SDD §11.1/§12.1). mission_orchestrator_node (GCS-004, Channel C) is NOT
# part of this container — SDD §12.4 resolved that as out of scope here.
# SDD §12.4: after fcc-bridge and mavlink-router.
# Installed by scripts/02-install-systemd-units.sh.
[Unit]
Description=Drone MC — GCS Communications
PartOf=drone-mc.target
After=docker.service drone-mc-health-monitor.service drone-mc-fcc-bridge.service drone-mc-mavlink-router.service
Requires=docker.service
Wants=drone-mc-fcc-bridge.service drone-mc-mavlink-router.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Slice=be.slice
EnvironmentFile=/etc/drone-mc/environment
ExecStart=/usr/bin/docker run --rm --name mc-gcs-comms \
  --network=host \
  --mount type=bind,src=/opt/drone-mc/install,dst=/opt/drone-mc/install \
  --mount type=bind,src=/etc/drone-mc,dst=/etc/drone-mc,readonly \
  --env-file /etc/drone-mc/environment \
  ghcr.io/drone-mc/gcs-comms:${MC_VERSION}
ExecStop=/usr/bin/docker stop mc-gcs-comms
Restart=on-failure
RestartSec=5s
MemoryMax=512M
CPUQuota=40%
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=drone-mc.target
