# drone-mc-swarm-coord.service — swarm_coordinator_node + formation_controller_node.
# SDD §12.4: after gcs-comms. Installed by scripts/02-install-systemd-units.sh.
[Unit]
Description=Drone MC — Swarm Coordinator
PartOf=drone-mc.target
After=docker.service drone-mc-health-monitor.service drone-mc-gcs-comms.service
Requires=docker.service drone-mc-gcs-comms.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Slice=rt.slice
EnvironmentFile=/etc/drone-mc/environment
ExecStart=/usr/bin/docker run --rm --name mc-swarm-coord \
  --network=host \
  --mount type=bind,src=/opt/drone-mc/install,dst=/opt/drone-mc/install \
  --mount type=bind,src=/etc/drone-mc,dst=/etc/drone-mc,readonly \
  --env-file /etc/drone-mc/environment \
  ghcr.io/drone-mc/swarm-coord:${MC_VERSION}
ExecStop=/usr/bin/docker stop mc-swarm-coord
Restart=on-failure
RestartSec=5s
MemoryMax=512M
CPUQuota=50%
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=drone-mc.target
