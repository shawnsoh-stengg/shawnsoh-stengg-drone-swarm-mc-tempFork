<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_exec</name>
  <version>0.1.0</version>
  <description>
    Mission-level intelligence nodes: mission_manager_node, the mission
    phase state machine (SDD-MC-001 §4, FR-001-005, FR-010-016,
    FR-060-064), and search_planner_node, boustrophedon coverage path
    planning (SDD-MC-001 §7, FR-040-046).
  </description>
  <maintainer email="junhong.lee@stengg.com">Jun Hong Lee</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>mc_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
