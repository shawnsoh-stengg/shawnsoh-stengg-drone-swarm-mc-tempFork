<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mc_test_utils</name>
  <version>0.1.0</version>
  <description>
    TP-NI (node integration) test infrastructure: launch_testing/pytest
    fixtures and the four hardware-facing mock nodes TP-MC-001 §2.4
    specifies (mock_fcc_node, mock_camera_node, mock_peer_node,
    mock_gcs_node), so node-integration tests can run against realistic
    hardware-facing inputs without real hardware (TEST-001).
  </description>
  <maintainer email="junhong.lee@stengg.com">Jun Hong Lee</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>mc_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosbag2_py</depend>
  <depend>rosidl_runtime_py</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
