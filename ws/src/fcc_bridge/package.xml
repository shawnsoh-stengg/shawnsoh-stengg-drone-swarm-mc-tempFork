<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fcc_bridge</name>
  <version>0.1.0</version>
  <description>
    Transport-agnostic MC&lt;-&gt;FCC abstraction (FccBackend) and its
    production uXRCE-DDS + MAVLink-mission-protocol implementation.
    SDD-MC-001 §3, ICD-MC-001 §3.
  </description>
  <maintainer email="junhong.lee@stengg.com">Jun Hong Lee</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>mavlink</depend>
  <depend>mc_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
