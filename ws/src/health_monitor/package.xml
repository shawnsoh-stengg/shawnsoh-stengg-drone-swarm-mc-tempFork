<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>health_monitor</name>
  <version>0.1.0</version>
  <description>
    System health monitoring, node liveness tracking, and failsafe decision
    tree, plus the systemd restart interface. SDD-MC-001 §10.
    SRS-MC-001 FR-070-076, SFR-001-008.
  </description>
  <maintainer email="junhong.lee@stengg.com">Jun Hong Lee</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>mc_msgs</depend>

  <!-- Not build dependencies: health_monitor_node's liveness watches
       (HEALTH-002, SDD §10.2) use rclcpp::GenericSubscription, which
       resolves each topic's typesupport by string at runtime rather than
       linking against the message package. Declared here anyway so these
       packages are guaranteed present at deploy time. -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
