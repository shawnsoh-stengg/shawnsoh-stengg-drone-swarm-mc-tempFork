@startuml 07-failsafe-sequence
' ─────────────────────────────────────────────────────────────
' Diagram 07: Failsafe and Watchdog Sequences
' Swarm Search Drone — Mission Computer (AI MC)
' MC-SRS-001  FR-070 to FR-076 · SFR-003 to SFR-008
' ─────────────────────────────────────────────────────────────

title "07 — Failsafe and Watchdog Sequences"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold

skinparam sequence {
  ArrowColor #3D5A80
  ArrowFontColor #2A4060
  ArrowFontSize 9
  ParticipantBorderColor #3D5A80
  ParticipantBackgroundColor #D8E8F8
  ParticipantFontSize 10
  ParticipantFontStyle bold
  LifeLineBorderColor #8AA8C8
  LifeLineBackgroundColor #D8E8F8
  BoxLineColor #8AA8C8
  BoxBackgroundColor #F4F8FF
  DividerBackgroundColor #E8F0FA
  DividerBorderColor #3D5A80
  DividerFontSize 10
  DividerFontStyle bold
  GroupBodyBackgroundColor #FAFBFF
  NoteBackgroundColor #FFFAE8
  NoteBorderColor #C09030
  NoteFontSize 9
}

participant "GCS" as GCS #D8EED8
participant "health_monitor\n_node" as HM #D0D0D0
participant "watchdog\nsupervisor" as WD #E8E0C0
participant "mission_manager\n_node" as EXEC #A8CCEE
participant "FccBackend\n(fcc_bridge)" as FCC_BE #C8E0F0
participant "FCC\n(PX4)" as FCC #FFD4A8

' ═══════════════════════════════════════════════════
' SCENARIO A: Normal heartbeat operation
' ═══════════════════════════════════════════════════
== Scenario A — Normal Watchdog Operation ==

loop Every 1 s  [FR-074]
  EXEC -> WD : /mc/manager/heartbeat
  WD -> HM : heartbeat received ✓
end

HM -> GCS : /mc/health (all nominal)

' ═══════════════════════════════════════════════════
' SCENARIO B: Manager node crash → restart
' ═══════════════════════════════════════════════════
== Scenario B — Manager Crash: Restart Attempt  [FR-074, SFR-003] ==

EXEC ->X WD : (manager crashes — heartbeat stops)

note over WD
  Watchdog polls /mc/manager/heartbeat.
  Timeout threshold: 5 s  [FR-074]
end note

WD -> WD : heartbeat timeout\n(5 s silence detected)

WD -> HM : MANAGER_UNRESPONSIVE
HM -> GCS : MAVLink: STATUSTEXT\n"WARN: manager unresponsive, restarting"

WD -> FCC_BE : vehicle_command: HOLD
FCC_BE -> FCC : vehicle_command: HOLD
FCC --> FCC_BE : mode = HOLD ✓
FCC_BE --> WD : HOLD confirmed

WD -> WD : systemd restart: mission-exec.service\n(attempt 1 of 3)

note right of WD
  systemctl restart mission-exec.service
  → Docker container restart
  → mission_manager_node relaunches
end note

EXEC -> WD : /mc/manager/heartbeat (resumed ✓)
WD -> HM : manager recovered (attempt 1)
HM -> GCS : STATUSTEXT "INFO: manager recovered"

' ═══════════════════════════════════════════════════
' SCENARIO C: 3× restart failure → RTL
' ═══════════════════════════════════════════════════
== Scenario C — 3× Restart Failure: Critical Fault → RTL  [FR-075, SFR-004] ==

EXEC ->X WD : (manager fails again)
WD -> WD : timeout (5 s)
WD -> WD : restart attempt 1 → FAILED
WD -> WD : restart attempt 2 → FAILED
WD -> WD : restart attempt 3 → FAILED

HM <- WD : CRITICAL_FAULT\n{node=mission_manager, restarts=3}

HM -> HM : declare FAULT phase\nset /mc/mission_phase = FAULT

HM -> GCS : MAVLink: STATUSTEXT\n"CRITICAL: manager failed ×3, commanding RTL"
HM -> GCS : /mc/health {fault_mask=MANAGER_DEAD}

HM -> FCC_BE : vehicle_command: RTL
FCC_BE -> FCC : vehicle_command: NAV_RETURN_TO_LAUNCH
FCC --> FCC_BE : RTL accepted ✓
FCC_BE --> HM : RTL confirmed

' ═══════════════════════════════════════════════════
' SCENARIO D: GCS link lost → HOLD
' ═══════════════════════════════════════════════════
== Scenario D — GCS Link Lost: Autonomous Phase HOLD  [FR-073, SFR-007] ==

GCS ->X EXEC : (GCS MAVLink link drops)

note over HM #FFE0E0
  <b>Real implementation (verified 2026-09-08, HEALTH-003):</b>
  health_monitor_node is the one that detects this — it consumes
  gcs_mavlink_node's /mc/gcs/link_status directly. mission_manager_node
  has no GCS-link timer of its own (no code match for it in
  mission_manager_node.cpp). HM publishes /mc/fault{GCS_LINK_LOST,
  action=HOLD} at deliberately NON-critical severity, specifically so
  it does NOT trip mission_manager_node's blanket critical-fault→RTL
  reaction. But mission_manager_node's on_fault()/guard_any_fault()
  machinery only ever knows how to RTL — there is no HOLD-consumption
  path implemented anywhere in the code.
  <b>Net effect: no FCC command is ever actually sent for this
  scenario today.</b> This is a documented, known gap (see
  HEALTH-003's own resolution notes), not a diagram omission.
end note

HM -> HM : /mc/gcs/link_status stale >10 s  [FR-073]
HM -> EXEC : /mc/fault {GCS_LINK_LOST,\nseverity=non-critical, action=HOLD}

note over EXEC, HM
  <color:#C02020>GAP: EXEC has no HOLD-consumption path for this
  fault — no vehicle_command is sent to FCC_BE.</color>
  SFR-007's target design once closed: drone holds position until GCS
  link recovers, applies in INGRESS, MUSTER, ISR_SELECTION,
  VORONOI_PARTITION, SEARCH.
end note

GCS -> EXEC : (link recovers)\nMAVLink HEARTBEAT received
EXEC -> GCS : MAVLink: HEARTBEAT + status
GCS -> EXEC : phase_command: SEARCH (resume)
EXEC -> FCC_BE : vehicle_command: MISSION
FCC_BE -> FCC : resume coverage path

' ═══════════════════════════════════════════════════
' SCENARIO E: Low battery → RTL
' ═══════════════════════════════════════════════════
== Scenario E — Low Battery: Automatic RTL  [FR-072, SFR-008] ==

note over HM, EXEC #FFE0E0
  <b>Real implementation (verified 2026-09-08, HEALTH-003):</b>
  health_monitor_node subscribes to /mc/fcc/vehicle_state directly
  (battery_pct) — mission_manager_node does not forward battery state
  to it. And per FR-026's single-commander invariant, HM itself never
  calls send_command() here — it only publishes /mc/fault{LOW_BATTERY,
  action=RTL}. The actual vehicle_command: RTL is sent by
  mission_manager_node's existing on_fault()/action_command_rtl()
  machinery, the same path FCC_LINK_LOST already used before
  HEALTH-003 existed.
end note

FCC -> FCC_BE : battery_status\n{remaining=19%, voltage=14.6V}
FCC_BE -> HM : /mc/fcc/vehicle_state\n{battery_pct=19%}

HM -> GCS : STATUSTEXT "WARN: battery 19%, initiating RTL"
HM -> GCS : /mc/health {fault_mask=LOW_BATTERY}
HM -> EXEC : /mc/fault {LOW_BATTERY,\nseverity=critical, action=RTL}

EXEC -> FCC_BE : vehicle_command: RTL
FCC_BE -> FCC : NAV_RETURN_TO_LAUNCH
FCC --> FCC_BE : RTL accepted

note right of HM
  SFR-008: suppressible only via
  override_low_battery_rtl_ (GCS
  OVERRIDE_LOW_BATTERY_RTL), which HM
  checks before publishing the fault at
  all. Default: always RTL.
end note

' ═══════════════════════════════════════════════════
' SCENARIO F: FCC comms loss → critical fault
' ═══════════════════════════════════════════════════
== Scenario F — FCC Communication Loss  [FR-015] ==

FCC_BE ->X EXEC : (uXRCE-DDS bridge silent)

note over FCC_BE
  fcc_bridge_node monitors last
  received uORB message timestamp.
  Timeout: 1 s  [FR-015]. Publishes
  vehicle_state.fcc_link_ok=false —
  health_monitor_node polls this field
  itself (same /mc/fcc/vehicle_state
  subscription as Scenario E's battery
  check), it is not pushed as a
  separate FCC_LINK_LOST event.
end note

FCC_BE -> FCC_BE : uXRCE-DDS silence >1 s
FCC_BE -> HM : /mc/fcc/vehicle_state\n{fcc_link_ok=false}
HM -> GCS : STATUSTEXT "CRITICAL: FCC link lost"
HM -> EXEC : /mc/fault {FCC_LINK_LOST,\nseverity=critical, action=RTL}

note over HM
  Per FR-026, HM never calls send_command()
  here either — mission_manager_node's
  existing on_fault() RTL path is reused
  (same as Scenario E). In practice the
  RTL command likely can't reach FCC via
  the same dead uXRCE-DDS link either; the
  FCC PX4 failsafe (RC loss / GCS loss)
  will independently trigger failsafe
  actions regardless.
  MC declares FAULT and notifies GCS.
end note

HM -> GCS : /mc/health {fault_mask=FCC_LINK_DEAD}

@enduml
