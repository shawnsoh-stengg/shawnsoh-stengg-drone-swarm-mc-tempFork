@startuml 14-sdd-detection-pipeline
' ─────────────────────────────────────────────────────────────
' Diagram 14: Detection and Geolocation Pipeline
' SDD §9 — perception_down_node (renamed from detection_node)
' SDD §9a — perception_front_node reuses this same engine + geolocation math
' MC-SDD-001
' ─────────────────────────────────────────────────────────────

title "14 — Detection and Geolocation Pipeline\nperception_down_node (renamed from detection_node)  ·  TensorRT Inference + Ray-Cast Geolocation  ·  SDD §9"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam shadowing false
skinparam RoundCorner 5

skinparam rectangle {
  BorderColor #3D5A80
  BorderThickness 1.5
  FontSize 10
}

skinparam component {
  BorderColor #3D5A80
  BorderThickness 1.5
  FontSize 10
}

skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #3D5A80
  BorderThickness 2
  FontSize 10
  FontStyle bold
}

skinparam note {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

skinparam arrow {
  Color #3D5A80
  FontColor #2A4060
  FontSize 9
}

' ═══════════════════════════════════════════════════
' INPUTS
' ═══════════════════════════════════════════════════

note as N_STATUS #FFE0E0
  <b>Status as of 2026-09-08: NOT YET IMPLEMENTED.</b>
  ws/src/vision/src/perception_down_node.cpp is still a 15-line scaffold
  — its own header says so directly: "Scaffold only — the TensorRT
  inference and camera-intrinsics/pose-based geolocation logic land
  with the vision implementation work." perception_front_node
  (video_downlink package) is likewise a scaffold. This diagram is the
  SDD §9/§9a design to build against, not a description of current
  behaviour.
end note

package "Inputs" as INPUTS #F0F6E8 {
  rectangle "/camera/image_raw\nBGR8 · 1280×720 · ≥15 FPS\n/camera/camera_info\n(K intrinsic matrix · D distortion)" as CAM_IN #C8DCC0
  rectangle "/mc/local_pose\nPoseWithCovarianceStamped\ndrone position (NED m) + quaternion\ncovariance (VO drift uncertainty)\n≥10 Hz" as POSE_IN #C8DCC0
}

' ═══════════════════════════════════════════════════
' INFERENCE PIPELINE (Jetson GPU)
' ═══════════════════════════════════════════════════

package "AI Inference Pipeline  (Jetson GPU — CUDA)" as GPU #E8E0F8 {

  rectangle "Frame Queue\n(ring buffer, depth=2)\nDrop oldest on overflow\n→ preserves camera pipeline\nfor visual_localisation_node" as FQUEUE #C8B0E8

  rectangle "Preprocessing Thread  (CPU)\nBGR8 → RGB\nResize: 1280×720 → 640×640\nNormalize: [0,255] → [0.0,1.0]\nCHW layout for TensorRT" as PREPROC #C8B0E8

  rectangle "TensorRT Inference  (GPU)\nModel: YOLOv8n / custom head\nInput:  640×640×3  (FP16)\nOutput: (N,85)  bboxes + scores\n─────────────────────\nEngine: /var/drone-mc/model.engine\nBuilt from: /etc/drone-mc/model.onnx\nFirst-run compile: ~60 s (Jetson)\nLatency: ≤500 ms per frame  [PR-007]" as TRT #B8A0D8

  rectangle "Non-Maximum Suppression  (CPU)\nIoU threshold: 0.45\nConfidence threshold: 0.50\n→ filtered (class_id, confidence,\n   bbox_x, bbox_y, bbox_w, bbox_h)" as NMS #C8B0E8

  rectangle "Rate Limiter\nMax inference rate: 15 FPS\n(ROS 2 param: inference_rate_limit_fps)\nFrames beyond rate dropped from queue\n→ GPU load ≤80%  [PR-010]" as RLIM #D0B8E8
}

' ═══════════════════════════════════════════════════
' GEOLOCATION
' ═══════════════════════════════════════════════════

package "Target Geolocation  (CPU · per detection)" as GEO #F0E8F8 {

  rectangle "Step 1 — Unproject to Camera Ray\nr_cam = K⁻¹ × [u, v, 1]ᵀ\nr_cam /= ‖r_cam‖\n(u,v = bounding box centre)" as UNPROJ #D8C0F0

  rectangle "Step 2 — Transform Ray to NED World Frame\nr_ned = T_body_ned × T_cam_body × r_cam\nT_cam_body: static TF from /tf_static\nT_body_ned:  rotation from drone_pose.q" as TFRAY #D8C0F0

  rectangle "Step 3 — Ray–Terrain Intersection\nterrain_alt = drone_alt_msl − search_alt_m\nλ = (terrain_alt − drone_z_ned) / r_ned.z\ntarget_ned  = drone_ned + λ × r_ned\n(flat-terrain assumption)" as INTERSECT #D8C0F0

  rectangle "Step 4 — Geodetic Conversion\ntarget_ned → (lat, lon, alt_msl)\nGeographicLib::LocalCartesian" as GEODETIC #D8C0F0

  rectangle "Step 5 — Uncertainty Propagation\nrange_m = λ\npx_fov = atan(sensor_W / (2 × fx))\npos_uncertainty_m = range × tan(px_fov)\n                  + VO covariance trace\n→ position_uncertainty_cm (uint16)" as UNCERT #D8C0F0
}

' ═══════════════════════════════════════════════════
' MODEL MANAGEMENT
' ═══════════════════════════════════════════════════

package "TensorRT Model Management" as MODELM #FFF0E0 {
  rectangle "Startup Sequence:\n1. Check /var/drone-mc/model.engine\n2. If absent: run trtexec from\n   /etc/drone-mc/model.onnx  (~60 s)\n3. Load engine + allocate CUDA buffers\n─────────────────────\nUpdate procedure:\n  Replace model.onnx, delete .engine\n  → rebuilt on next node restart" as MGMT #FFD4A8
}

' ═══════════════════════════════════════════════════
' OUTPUTS
' ═══════════════════════════════════════════════════

package "Outputs" as OUTPUTS #F0F6E8 {
  rectangle "/mc/detections\nmc_msgs/DetectionArray\nper detection:\n  class_id · class_name · confidence\n  lat_e7, lon_e7, alt_mm\n  position_uncertainty_cm\n  drone_id · detection_id · stamp" as DETOUT #C8DCC0
}

package "→ gcs_mavlink_node" as GCSOUT #E8F4E8 {
  rectangle "MC_DETECTION (50101)\nevent-driven, ≤1 s after detection\n(same fields as /mc/detections)" as MAVDET #B8DCA8
}

' ═══════════════════════════════════════════════════
' GIMBAL PERCEPTION (perception_front_node · SDD §9a)
' independent node instance, same engine/geolocation math
' ═══════════════════════════════════════════════════

package "perception_front_node  ·  SDD §9a  (video_downlink package)" as GIMPKG #E0F4EC {
  rectangle "RTSP/H.265 stream\nrtsp://192.168.100.200:8554/stream1\n(gimbal camera, shared switch, HIF-007)\nvia rtspsrc → same Frame Queue /\nPreprocessing / TensorRT / NMS pattern\nas the boxes above (independent instance)" as GIMIN #A8E0C8

  rectangle "IoU Tracker  (CPU)\nGreedy frame-to-frame bbox IoU match\n(track_iou_threshold=0.3)\nframes_tracked++ on match\ndropped after track_miss_limit=10 misses" as TRACKER #90D0B0

  rectangle "/mc/perception/front/detections\nmc_msgs/DetectionArray  (event, ≤1 s)\n/mc/perception/front/tracks\nmc_msgs/TrackArray  (≥5 Hz)" as GIMOUT #78C0A0
}

package "→ video_mux_node" as VMUXOUT #D0EFE0 {
  rectangle "GCS video downlink\nRTSP/H.265 + metadata mux\n:8555/mc_video  (IFD-007)" as VMUXBOX #A8E0C8
}

' ═══════════════════════════════════════════════════
' FLOW
' ═══════════════════════════════════════════════════

CAM_IN  --> FQUEUE   : raw frames (≥15 FPS)
FQUEUE  --> RLIM     : next frame (rate-gated)
RLIM    --> PREPROC  : frame to process
PREPROC --> TRT      : normalised tensor\n(640×640×3 FP16)
TRT     --> NMS      : raw detections\n(N, 85) — all classes
NMS     --> UNPROJ   : filtered bboxes\n(per detection)

POSE_IN --> TFRAY    : drone_pose.q → T_body_ned
POSE_IN --> INTERSECT : drone_alt_msl, drone_z_ned
POSE_IN --> UNCERT    : VO covariance matrix

UNPROJ    --> TFRAY
TFRAY     --> INTERSECT
INTERSECT --> GEODETIC
GEODETIC  --> UNCERT
UNCERT    --> DETOUT  : assembled Detection msg

DETOUT    --> GCSOUT  : forwarded by gcs_mavlink_node

MGMT     --> TRT      : loaded engine

' Gimbal perception branch (independent node/instance, reuses TRT + geolocation)
GIMIN     ..> TRT      : reuses same engine\n(independent instance)
GIMIN     ..> UNPROJ   : reuses same geolocation math\n(gimbal-mount TF)
NMS       ..> TRACKER : (analogous NMS output\nfor the gimbal instance)
TRACKER   --> GIMOUT   : tracks + detections
GIMOUT    --> VMUXOUT  : frames + /mc/perception/front/*

' ═══════════════════════════════════════════════════
' NOTES
' ═══════════════════════════════════════════════════

note bottom of FQUEUE
  Queue depth 2: backpressure from GPU cannot
  stall the camera pipeline. visual_localisation_node
  receives the same /camera/image_raw stream
  independently — no coupling between consumers.
end note

note right of TRT
  Inference runs on a dedicated std::thread.
  Results posted back to ROS 2 callback queue
  via a result-queue polled by WallTimer.
  Keeps ROS 2 thread safety intact.
  GPU resource limit enforced by
  inference_rate_limit_fps param.  [PR-010]
end note

note bottom of INTERSECT
  Flat-terrain assumption: target assumed at
  (drone_alt_msl − search_altitude_m).
  Error proportional to terrain relief.
  DEM-based intersection planned for future revision.
end note

note right of UNCERT
  Two uncertainty sources are summed:
  1. Pixel FOV at slant range (geometric)
  2. VO position covariance trace (localisation)
  Combined 1-sigma published as position_uncertainty_cm.
end note

note bottom of GIMPKG
  perception_front_node is a separate node/process (video_downlink package,
  not vision) with its own Frame Queue / TensorRT context — it reuses the
  same model and geolocation algorithm as perception_down_node above
  (SDD §9.2, §9.3) rather than sharing runtime state. Both are subject to
  the shared ≤80% GPU throughput budget (PR-010, FR-082).
end note

@enduml
