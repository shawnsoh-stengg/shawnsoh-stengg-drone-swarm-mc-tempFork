@startuml 03-container-deployment
' ─────────────────────────────────────────────────────────────
' Diagram 03: Container and Systemd Deployment
' Swarm Search Drone — Mission Computer (AI MC)
' MC-SRS-001
' ─────────────────────────────────────────────────────────────

title "03 — Container Deployment\nDocker Engine · systemd · cgroups v2"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam ArrowColor #4A6080
skinparam ArrowFontColor #4A6080
skinparam ArrowFontSize 9
skinparam RoundCorner 4
skinparam Padding 5

skinparam node {
  BackgroundColor #E8F0FA
  BorderColor #3D5A80
  BorderThickness 2
  FontSize 11
  FontStyle bold
}

skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #6A8AB0
  BorderThickness 1
  FontSize 10
  FontStyle bold
}

skinparam artifact {
  BackgroundColor #FFFAE8
  BorderColor #B09020
  BorderThickness 1
  FontSize 10
}

skinparam component {
  BackgroundColor #DDEEFF
  BorderColor #3A70A0
  BorderThickness 1
  FontSize 10
}

skinparam database {
  BackgroundColor #F0F0F0
  BorderColor #707070
}

' ═══════════════════════════════════════════════════
' HOST: Jetson Orin NX 16GB
' ═══════════════════════════════════════════════════
node "Jetson Orin NX 16GB\nJetPack 6.2.2 · Ubuntu 22.04 · aarch64\n192.168.10.11" as JETSON {

  ' ─── systemd target ───────────────────────────
  package "drone-mc.target  (systemd)" as TARGET #E8F4FF {

    ' ─── rt.slice (real-time) ─────────────────
    package "rt.slice  (real-time cgroup)" as RT_SLICE #FFE8E0 {

      package "fcc-bridge.service" as SVC_FCC #FFDDD0 {
        component "Micro XRCE-DDS Agent" as UXRCE
        component "fcc_bridge_node" as N_FCC
      }

      package "swarm-coord.service" as SVC_SWARM #FFDDD0 {
        component "swarm_coordinator_node" as N_SWARM
        component "formation_controller_node" as N_FORM
      }

    }

    ' ─── be.slice (best-effort) ───────────────
    package "be.slice  (best-effort cgroup)" as BE_SLICE #E8F8E8 {

      package "mavlink-router.service" as SVC_MLR #D8F0D8 {
        component "mavlink-router v4" as MLR
      }

      package "zenoh-bridge.service" as SVC_ZENOH #D8F0D8 {
        component "zenoh-bridge-dds" as ZBD
      }

      package "gcs-comms.service" as SVC_GCS #D8F0D8 {
        component "gcs_mavlink_node" as N_GCS
        component "MAVROS" as MAVROS
      }

      package "mission-exec.service" as SVC_EXEC #D8F0D8 {
        component "mission_manager_node" as N_EXEC
        component "search_planner_node" as N_PLAN
        component "watchdog supervisor" as WD
      }

      package "camera.service" as SVC_CAM #D8F0D8 {
        component "camera_node  (gscam2)" as N_CAM
      }

      package "vision.service" as SVC_VIS #D8F0D8 {
        component "visual_localisation_node" as N_VIS
        component "perception_down_node\n(renamed from detection_node)" as N_DET
      }

      package "mission-orchestrator.service" as SVC_ORCH #D8F0D8 {
        component "mission_orchestrator_node\n(GCS-006 — see diagram 05,\nChannel C)" as N_ORCH
      }

      package "video-ingest.service  [NOT YET BUILT —\nSDD-MC-001 §12.4 design only]" as SVC_INGEST #E8E8E8;line.dashed {
        component "perception_front_node" as N_PFRONT
      }

      package "video-downlink.service  [NOT YET BUILT —\nSDD-MC-001 §12.4 design only]" as SVC_VIDEO #E8E8E8;line.dashed {
        component "video_mux_node" as N_VMUX
      }

      package "health-monitor.service" as SVC_HM #D8F0D8 {
        component "health_monitor_node" as N_HM
      }

    }

  }

  ' ─── shared workspace ─────────────────────────
  database "Shared colcon workspace\n/opt/drone-mc/install\n(bind-mounted into all containers)" as WS

  ' ─── hardware devices ─────────────────────────
  package "Hardware Interfaces" as HW #F0F0F8 {
    artifact "ttyTHS1\n(serial → FCC)" as TTY
    artifact "/dev/video*\n(CSI camera)" as VIDDEV
    artifact "eth0 192.168.10.11\n(ethernet → FCC 192.168.10.31)" as ETH_INT
    artifact "192.168.10.x\n(MANET mesh)" as ETH_MESH
    artifact "192.168.10.200\n(gimbal camera, shared switch, HIF-007)" as ETH_GIMCAM
  }

}

' ─── Base image (shared) ──────────────────────
package "Container Base Image\nros2-core\n(ROS 2 Humble · CycloneDDS, lo-only)" as BASE #F8F8D8 {
  component "cyclonedds.xml\n(same-host DDS config)" as DDS_CFG
}

' ─── zenoh-bridge config (not part of ros2-core; standalone image) ──
package "zenoh-bridge-dds.json5\n(cross-host DDS config)" as ZBD_CFG #F8F8D8

' ─── External references ──────────────────────
node "Pixhawk 6X FCC\n192.168.10.31" as FCC_HW #FFECD8
node "GCS · QGC\n192.168.10.10" as GCS_HW #D8EED8
node "MANET Peers\n192.168.10.12+" as PEER_HW #F5ECF5

' ═══════════════════════════════════════════════════
' CONNECTIONS
' ═══════════════════════════════════════════════════

BASE <.. SVC_FCC : "extends"
BASE <.. SVC_SWARM : "extends"
BASE <.. SVC_GCS : "extends"
BASE <.. SVC_EXEC : "extends"
BASE <.. SVC_CAM : "extends"
BASE <.. SVC_VIS : "extends"
BASE <.. SVC_ORCH : "extends"
BASE <.[#888888,dashed].. SVC_INGEST : "would extend\n(not built)"
BASE <.[#888888,dashed].. SVC_VIDEO : "would extend\n(not built)"
BASE <.. SVC_HM : "extends"

WS --> SVC_FCC : "bind mount"
WS --> SVC_SWARM : "bind mount"
WS --> SVC_GCS : "bind mount"
WS --> SVC_EXEC : "bind mount"
WS --> SVC_CAM : "bind mount"
WS --> SVC_VIS : "bind mount"
WS --> SVC_ORCH : "bind mount"
WS --> SVC_HM : "bind mount"

TTY --> SVC_FCC : "DeviceAllow"
VIDDEV --> SVC_CAM : "DeviceAllow /dev/video0"
ETH_INT --> SVC_FCC
ETH_GIMCAM .[#888888,dashed].> SVC_INGEST : "DeviceAllow (network_mode=host)\n(not built)"

SVC_FCC --> FCC_HW : "uXRCE-DDS\nttyTHS1 / 192.168.10.31:8888"
SVC_MLR --> GCS_HW : "MAVLink 2/UDP\nChannel A/B (+ Channel C\nfor SVC_ORCH below)"
SVC_ORCH .[#4060C0].> GCS_HW : "MAVLink 2/UDP\nChannel C, routed via\nSVC_MLR — see diagram 05"
SVC_FCC --> SVC_ORCH : "required by\n(GCS-006 unit dependency)"
SVC_CAM --> SVC_VIS : "/camera/image_raw\n(cross-container, same-host DDS)"
SVC_FCC --> SVC_VIS : "IMU pre-integration scale\n(cross-container, same-host DDS)"
SVC_SWARM --> PEER_HW : "Swarm protocol/UDP\n192.168.10.x"
SVC_ZENOH --> PEER_HW : "Zenoh mesh (DDS bridge)\nTCP :7447 / 192.168.10.x"
ZBD_CFG --> SVC_ZENOH : "bind mount\n/etc/drone-mc"
SVC_INGEST .[#888888,dashed].> SVC_VIDEO : "/mc/perception/front/detections\n/mc/perception/front/tracks\n(same-host DDS, cross-container)\n(neither service built yet)"
SVC_VIDEO .[#888888,dashed].> GCS_HW : "RTSP/H.265 + metadata\nStream A :8555 (gimbal) · Stream B :8556 (downward)\nindependent of MAVLink — not built yet"

note right of SVC_FCC
  DeviceAllow=ttyTHS1
  MemoryMax=512M
  CPUQuota=50%
  PrivateTmp=yes
end note

note right of SVC_CAM
  network_mode=host
  DeviceAllow=/dev/video0 rw
  MemoryMax=1G
  CPUQuota=50%
  Split out from vision.service so the
  lightweight capture path can restart
  independently of the GPU-heavy
  VO/detection pipeline below.
end note

note right of SVC_VIS
  DeviceAllow=/dev/nvhost-gpu rw
  DeviceAllow=/dev/nvmap rw
  MemoryMax=6G
  CPUQuota=100%
  Requires=camera.service, fcc-bridge.service
  (image stream + IMU pre-integration scale)
end note

note right of SVC_ORCH
  network_mode=host
  MemoryMax=256M
  CPUQuota=20%
  Requires=fcc-bridge.service, mavlink-router.service
  Bind-mounts /var/drone-mc/mission_plans
  (plan-library persistence across restarts, GCS-006 AC4)
end note

note right of SVC_INGEST
  NOT YET BUILT — no docker/video-ingest
  directory, systemd unit, or build script
  exists yet (SDD-MC-001 §12.4 design only).
  Intended design once built:
  network_mode=host (RTSP :8554 ingest)
  DeviceAllow=/dev/nvidia*
  MemoryMax=4G
  GPUAccess=all
  Split into its own container so an
  RTSP-link/inference hang here can't
  take video-downlink.service down with it.
end note

note right of SVC_VIDEO
  NOT YET BUILT — no docker/video-downlink
  directory, systemd unit, or build script
  exists yet (SDD-MC-001 §12.4 design only).
  Intended design once built:
  network_mode=host (RTSP :8555/:8556)
  DeviceAllow=/dev/nvidia*
  MemoryMax=4G
  GPUAccess=all
  Stream A subscribes to video-ingest's
  output; Stream B subscribes to vision
  container's /camera/image_raw +
  /mc/detections.
end note

note right of SVC_ZENOH
  Peer mode, static locators
  (no multicast scouting).
  Forwards no topics by default —
  no cross-host DDS topic exists yet.
end note

note bottom of TARGET
  systemctl start drone-mc.target
  brings up all services in dependency order.
  Stopping the target cleanly shuts down
  all containers.
end note

@enduml
