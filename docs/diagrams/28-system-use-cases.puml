@startuml 28-system-use-cases
' ─────────────────────────────────────────────────────────────
' Diagram 28: System Use Cases — Human Actors
' Swarm Search Drone — Mission Computer (AI MC)
' MC-SRS-001 · MISSION-ORCHESTRATOR-MAVLINK-INTERFACE-SPEC.md
' ─────────────────────────────────────────────────────────────

title "28 — System Use Cases\nGCS Operator (QGroundControl) & Mission Planner (Mission Orchestrator)"

left to right direction

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 11
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam ArrowColor #4A6080
skinparam ArrowFontColor #3A5070
skinparam ArrowFontSize 9
skinparam RoundCorner 6
skinparam Padding 5

skinparam actor {
  BackgroundColor #E8F0FA
  BorderColor #3D5A80
  FontSize 11
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #D8E8F8
  BorderColor #3A70A0
  FontSize 10
}

skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #3D5A80
  BorderThickness 2
  FontSize 12
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

' ═══════════════════════════════════════════════════
' ACTORS
' ═══════════════════════════════════════════════════
actor "GCS Operator\n(via QGroundControl)" as OPERATOR #B8DCBA
actor "Mission Planner\n(via Mission Orchestrator)\n[another team's app]" as PLANNER #C8D8F0
actor "Peer Drone MC" as PEER #E8D8F0

' ═══════════════════════════════════════════════════
' SYSTEM BOUNDARY
' ═══════════════════════════════════════════════════
rectangle "Swarm Search Drone — Mission Computer System" as SYSTEM #F8F8FF {

  package "Vehicle Telemetry & Control  (MAVLink, QGC)" as PKG_TELEM #D8EED8 {
    usecase "Monitor vehicle telemetry\n(position, battery, mode)" as UC_TELEM #B8DCBA
    usecase "View AI detections" as UC_DET #B8DCBA
    usecase "View live video downlink\n(gimbal + downward, RTSP/H.265)" as UC_VIDEO #B8DCBA
    usecase "Arm / disarm vehicle" as UC_ARM #B8DCBA
    usecase "Command flight-mode change" as UC_MODE #B8DCBA
    usecase "Override autonomous behavior\n(≤500 ms authority, FR-003)" as UC_OVERRIDE #B8DCBA
  }

  package "Mission Plan Library  (MAVLink/MAVFTP, GCS-004)" as PKG_PLAN #E0E8F8 {
    usecase "Create mission plan" as UC_CREATE #C8D8F0
    usecase "List / browse stored plans" as UC_LIST #C8D8F0
    usecase "Update mission plan" as UC_UPDATE #C8D8F0
    usecase "Activate mission plan" as UC_ACTIVATE #C8D8F0
    usecase "Delete mission plan" as UC_DELETE #C8D8F0
  }

  package "Swarm Coordination  (custom UDP protocol, machine actor)" as PKG_SWARM #F5ECF5 {
    usecase "Exchange heartbeat /\npeer liveness" as UC_HB #E0C8F0
    usecase "Participate in ISR election" as UC_ISR #E0C8F0
    usecase "Participate in Voronoi\npartition consensus" as UC_VOR #E0C8F0
  }
}

' ═══════════════════════════════════════════════════
' ASSOCIATIONS
' ═══════════════════════════════════════════════════
OPERATOR --> UC_TELEM
OPERATOR --> UC_DET
OPERATOR --> UC_VIDEO
OPERATOR --> UC_ARM
OPERATOR --> UC_MODE
OPERATOR --> UC_OVERRIDE

PLANNER --> UC_CREATE
PLANNER --> UC_LIST
PLANNER --> UC_UPDATE
PLANNER --> UC_ACTIVATE
PLANNER --> UC_DELETE

PEER --> UC_HB
PEER --> UC_VOR
PEER --> UC_ISR

UC_ACTIVATE .down.> UC_ARM : "<<precedes>>\ngates PREFLIGHT→ARMING\n(pre_arm_checks)"
UC_OVERRIDE .down.> UC_ACTIVATE : "<<constrains>>\nGCS authority takes\nprecedence at all times"

note right of PKG_PLAN
  MAVLink Channel C + MAVFTP, JSON
  plan files — off-the-shelf MAVFTP
  client support (QGC/MAVSDK/pymavlink).
  MC-side node (mission_orchestrator_node)
  is done — GCS-004, 2026-08-05. The
  Mission Orchestrator app itself is out
  of scope for this project (another
  team's deliverable, not yet built).
  See MISSION-ORCHESTRATOR-MAVLINK-INTERFACE-SPEC.md.
end note

note right of PKG_SWARM
  Not a human actor — included for
  whole-system completeness. Peer MCs
  are symmetric: each drone is also a
  "Peer Drone MC" to every other drone.
end note

note left of PKG_TELEM
  Standard MAVLink 2/UDP, unchanged.
  QGC has no MAVLink-compatibility
  workaround needed — native UI.
end note

legend right
  | Color | Actor / Domain |
  | <#B8DCBA> | GCS Operator — QGroundControl (MAVLink, unchanged) |
  | <#C8D8F0> | Mission Planner — Mission Orchestrator (MAVLink/MAVFTP; MC side done, GCS-004) |
  | <#E0C8F0> | Peer Drone MC — swarm coordination (custom UDP, machine actor) |
endlegend

@enduml
