@startuml 02-software-architecture
' ─────────────────────────────────────────────────────────────
' Diagram 02: Software Architecture — ROS 2 Node Topology
' Swarm Search Drone — Mission Computer (AI MC)
' MC-SRS-001
' ─────────────────────────────────────────────────────────────

title "02 — Software Architecture\nROS 2 Node Topology · Mission Computer"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam ArrowColor #4A6080
skinparam ArrowFontColor #3A5070
skinparam ArrowFontSize 9
skinparam RoundCorner 4
skinparam Padding 4

skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #3D5A80
  BorderThickness 2
  FontSize 10
  FontStyle bold
}

skinparam component {
  BackgroundColor #D8E8F8
  BorderColor #3A70A0
  BorderThickness 1
  FontSize 10
}

skinparam interface {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

skinparam database {
  BackgroundColor #F0F0F0
  BorderColor #707070
  FontSize 10
}

' ═══════════════════════════════════════════════════
' EXTERNAL SYSTEMS
' ═══════════════════════════════════════════════════

package "PX4 FCC  (uXRCE-DDS bridge)" as FCC_PKG #FFECD8 {
  component "uORB Topics\nvehicle_local_position\nvehicle_status · battery_status\nvehicle_attitude · vehicle_odometry" as UORB #FFD4A8
}

package "GCS  (MAVLink 2/UDP  ·  192.168.10.10)" as GCS_PKG #D8EED8 {
  component "QGroundControl\nVehicle telemetry/control\nCommands · Detections" as QGC #B8DCA8
}

' "GCS" is two separate actors: QGC above (MAVLink Channels A/B, unchanged)
' and the Mission Orchestrator below (MAVLink Channel C + MAVFTP,
' MISSION-ORCHESTRATOR-MAVLINK-INTERFACE-SPEC.md; transport reversed from
' an earlier Zenoh proposal on 2026-07-24). GCS-004 (this project's
' MC-side implementation — mission_orchestrator_node, mavlink-router-
' channel-c) is done as of 2026-08-05. The Orchestrator App box below is
' still the OTHER team's deliverable and has not been built yet — dashed.
package "Mission Orchestrator  (MAVLink Channel C  ·  another team's app)\n[not yet built]" as ORCH_PKG #E0E8F8 {
  component "Mission Orchestrator App\nMission plan library\nCreate · List · Update\nActivate · Delete" as ORCH_APP #C8D8F0;line.dashed
}

package "Swarm Peers  (MANET · 192.168.10.x)" as PEER_PKG #F5ECF5 {
  component "Peer MCs\nHeartbeat · ISR selection\nVoronoi consensus" as PEERS #E0C8F0
}

database "IMX219 CSI Camera" as CAM #EDE0F8

database "Gimbal IP Camera\n192.168.10.200 (shared switch)" as GIMCAM #EDE0F8

' ═══════════════════════════════════════════════════
' CONTAINER: fcc-bridge
' ═══════════════════════════════════════════════════
package "fcc-bridge" as C_FCC #E0ECF8 {
  component "fcc_bridge_node\n[FccBackend interface]\nTransport-agnostic FCC adapter\nuXRCE-DDS ↔ ROS 2" as FCC_BRIDGE #A8CCEE
}

' ═══════════════════════════════════════════════════
' CONTAINER: mavlink-router (ONE container/service — entrypoint.sh
' launches 3 independent mavlink-routerd processes, one per channel
' .conf, sharing no process or routing table; not 3 containers)
' ═══════════════════════════════════════════════════
package "mavlink-router" as C_MLR #E0F0E8 {
  component "mavlink_router v4\n(channel-a.conf)\nChannel A routing" as MLR #B8DCA8
  component "mavlink_router v4\n(channel-b.conf)\nChannel B routing" as MLR_B #B8DCA8
  component "mavlink_router v4\n(channel-c.conf)\nChannel C routing" as MLR_C #B8DCA8
}

' ═══════════════════════════════════════════════════
' CONTAINER: gcs-comms (gcs_mavlink_node + MAVROS as a second,
' independent OS process — GCS-005 deliberately scoped MAVROS to
' mirror Channel A telemetry, NOT to be gcs_mavlink_node's own
' transport; see SDD-MC-001.md §11.1)
' ═══════════════════════════════════════════════════
package "gcs-comms" as C_GCS #E0F0E8 {
  component "gcs_mavlink_node\nGCS↔MC Channel B\nCommand · Telemetry · Detections" as GCS_NODE #90C890
  component "MAVROS\n(mavros_node, apt package)\nMirrors Channel A telemetry\nonly — not gcs_mavlink_node's\ntransport (GCS-005)" as MAVROS_NODE #A8D8A8
}

' ═══════════════════════════════════════════════════
' CONTAINER: mission-orchestrator (own container/service, GCS-006 —
' deliberately NOT folded into gcs-comms; see that unit's own header
' comment in config/systemd/drone-mc-mission-orchestrator.service)
' ═══════════════════════════════════════════════════
package "mission-orchestrator" as C_ORCH #E0F0E8 {
  component "mission_orchestrator_node\nMAVFTP server\nMission plan library (JSON)\nCreate · List · Update\nActivate · Delete" as ORCH_NODE #90C890
}

' ═══════════════════════════════════════════════════
' CONTAINER: swarm-coord — SCAFFOLD ONLY. Both node .cpp files are a
' bare Node() constructor + one startup log line (15 lines each,
' zero create_publisher/create_subscription/create_wall_timer calls,
' verified 2026-09-08). None of the design below (ISR election, Voronoi
' partitioning, peer heartbeat) is implemented yet.
' ═══════════════════════════════════════════════════
package "swarm-coord  [SCAFFOLD — not implemented]" as C_SWARM #E8E0F0;line.dashed {
  component "swarm_coordinator_node  [SCAFFOLD]\nDesign: peer discovery · heartbeat\nISR selection · Voronoi consensus\n(none of this exists in code yet)" as SWARM #D8C8E8;line.dashed
  component "formation_controller_node  [SCAFFOLD]\nDesign: PD position controller\nNED setpoints ≥2 Hz (FCC-010)\n(none of this exists in code yet)" as FORM #E0D0F0;line.dashed
}

' ═══════════════════════════════════════════════════
' CONTAINER: mission-exec — mission_manager_node is real (907 lines,
' full state machine implemented). search_planner_node is SCAFFOLD ONLY
' (bare Node() constructor, 15 lines, zero pub/sub/timer calls,
' verified 2026-09-08) — boustrophedon coverage is design only.
' ═══════════════════════════════════════════════════
package "mission-exec" as C_EXEC #FFF0E0 {
  component "mission_manager_node\n[State machine]\nPREFLIGHT → FAULT\nGCS authority · Autonomous triggers\nWatchdog heartbeat ≥1 Hz" as EXEC #FFD090
  component "search_planner_node  [SCAFFOLD]\nDesign: boustrophedon path\nVoronoi cell → waypoints\n(none of this exists in code yet)" as PLAN #FFE8C0;line.dashed
}

' ═══════════════════════════════════════════════════
' CONTAINER: camera (split OUT of vision.service 2026-07-22 — its own
' drone-mc-camera.service, so the lightweight capture path can restart
' independently of the GPU-heavy VO/detection pipeline below)
' ═══════════════════════════════════════════════════
package "camera" as C_CAM #F4EEF8 {
  component "camera_node\n(gscam2)\nIMX219 CSI driver\n/camera/image_raw ≥15 FPS" as CAMNODE #E0C8F8
}

' ═══════════════════════════════════════════════════
' CONTAINER: vision — SCAFFOLD ONLY (camera_node lives in its own
' "camera" container, above, and IS real/deployed). Both remaining
' nodes' .cpp files are a bare Node() constructor + one startup log
' line (15 lines each, zero pub/sub/timer calls, verified 2026-09-08).
' Neither the VO pipeline nor the detection pipeline is implemented yet.
' ═══════════════════════════════════════════════════
package "vision  [SCAFFOLD — not implemented]" as C_VIS #EEE4F8;line.dashed {
  component "visual_localisation_node  [SCAFFOLD]\nDesign: visual odometry + IMU fusion\n6-DoF pose ≥10 Hz, GNSS-denied fallback\n(none of this exists in code yet)" as VISLOC #DCC8F0;line.dashed
  component "perception_down_node  [SCAFFOLD]\n(renamed from detection_node)\nDesign: AI inference (GPU)\nTarget detection ≤500 ms latency\n(none of this exists in code yet)" as DET #D0B8EC;line.dashed
}

' ═══════════════════════════════════════════════════
' CONTAINER: video-ingest — NOT YET BUILT (SDD-MC-001.md §12.4 design
' only: no docker/video-ingest directory, systemd unit, or build script
' exists). Intended design: split out of a shared video-uplink container
' so perception_front_node's RTSP-link flakiness/GPU inference doesn't
' share a restart cycle with video_mux_node (Stream B, FR-086).
' ═══════════════════════════════════════════════════
package "video-ingest  [NOT YET BUILT]" as C_INGEST #E8E8E8;line.dashed {
  component "perception_front_node\nRTSP/H.265 ingest (gimbal)\nAI inference + tracking\nSearch & detection (front-facing)\nIndependent of vision pipeline" as PFRONT #C8E0D8;line.dashed
}

' ═══════════════════════════════════════════════════
' CONTAINER: video-downlink — NOT YET BUILT (SDD-MC-001.md §12.4 design
' only: no docker/video-downlink directory, systemd unit, or build
' script exists; both nodes already live in the one video_downlink ROS 2
' package, which builds natively via colcon but has no service/container
' of its own yet)
' ═══════════════════════════════════════════════════
package "video-downlink  [NOT YET BUILT]" as C_VIDEO #E8E8E8;line.dashed {
  component "video_mux_node\nRe-encode + metadata mux\nStream A :8555 (gimbal)\nStream B :8556 (downward)" as VMUX #C0E0D0;line.dashed
}

' ═══════════════════════════════════════════════════
' CONTAINER: health-monitor
' ═══════════════════════════════════════════════════
package "health-monitor" as C_HEALTH #F0F0F0 {
  component "health_monitor_node\nCPU · Memory · GPU temp\nNode liveness · Failsafe trigger\n/mc/health ≥1 Hz" as HEALTH #D0D0D0
}

' ═══════════════════════════════════════════════════
' EXTERNAL ↔ INTERNAL CONNECTIONS
' ═══════════════════════════════════════════════════
UORB <--> FCC_BRIDGE : "uXRCE-DDS\nttyTHS1 / 192.168.12.x"
QGC <--> MLR : "MAVLink 2/UDP\nChannel A (autopilot,\nno ROS 2 node consumer)"
QGC <--> MLR_B : "MAVLink 2/UDP\nChannel B"
MLR <--> MAVROS_NODE : "MAVLink 2/UDP :14553\n(MAVROS_CHANNEL_A endpoint)"
MLR_B <--> GCS_NODE
ORCH_APP ..> MLR_C : "MAVLink 2/UDP (Channel C)\n:14571/14572, MAVFTP\n[dashed: Orchestrator App not yet built]"
MLR_C --> ORCH_NODE : ":14580 (loopback)"
PEERS .[#888888,dashed].> SWARM : "Swarm protocol/UDP\nMANET · 192.168.10.x\n(SWARM is a scaffold — not implemented)"
CAM --> CAMNODE : "CSI"
GIMCAM .[#888888,dashed].> PFRONT : "RTSP/H.265\n:8554 (shared switch, HIF-007)\n(not built yet)"

' ═══════════════════════════════════════════════════
' INTERNAL ROS 2 TOPIC FLOWS
' ═══════════════════════════════════════════════════

' FCC bridge → consumers
FCC_BRIDGE -down-> EXEC : "/mc/fcc/vehicle_state"
FCC_BRIDGE .[#888888,dashed].> FORM : "/mc/fcc/vehicle_state\n(FORM is a scaffold — not implemented)"
FCC_BRIDGE .[#888888,dashed].> VISLOC : "(IMU data)\n(VISLOC is a scaffold — not implemented)"

' Mission manager → all
EXEC -right-> GCS_NODE : "/mc/mission_phase"
EXEC --> HEALTH : "/mc/manager/heartbeat"

' GCS node → manager
GCS_NODE -left-> EXEC : "/mc/gcs/command\n/mc/gcs/mission_upload"

' Mission Orchestrator → manager (same topic, on activate — mission_manager_node
' needs zero changes to accept either source, see
' MISSION-ORCHESTRATOR-MAVLINK-INTERFACE-SPEC.md §5.4)
ORCH_NODE --> EXEC : "/mc/gcs/mission_upload (on activate)"

' Swarm → consumers (SWARM/FORM/PLAN are all scaffolds — not implemented)
SWARM .[#888888,dashed].> FORM : "/mc/swarm/peer_states\n(not implemented)"
SWARM .[#888888,dashed].> PLAN : "/mc/swarm/voronoi_cell\n(not implemented)"
SWARM .[#888888,dashed].> EXEC : "/mc/swarm/isr_role\n(not implemented)"

' Formation → FCC (FORM is a scaffold — not implemented)
FORM .[#888888,dashed].> FCC_BRIDGE : "/mc/fcc/mission_item_update\n(MISSION mode)\n(not implemented)"

' Search planner → manager (PLAN is a scaffold — not implemented)
PLAN .[#888888,dashed].> EXEC : "/mc/search/coverage_path\n(not implemented)"

' Vision pipeline (VISLOC/DET are scaffolds — not implemented;
' CAMNODE/camera_node itself is real and deployed)
CAMNODE .[#888888,dashed].> VISLOC : "/camera/image_raw\n(VISLOC not implemented)"
CAMNODE .[#888888,dashed].> DET : "/camera/image_raw\n(DET not implemented)"
VISLOC .[#888888,dashed].> DET : "/mc/local_pose\n(neither implemented)"
VISLOC .[#888888,dashed].> FCC_BRIDGE : "(vehicle_visual_odometry)\n(VISLOC not implemented)"

' Detections → GCS (both cameras report their own detections over MAVLink,
' per ICD §9.1's topic catalogue — gcs_mavlink is a documented subscriber
' of both /mc/detections and /mc/perception/front/detections; both
' producers, DET and PFRONT, are scaffolds — not implemented)
DET .[#888888,dashed].> GCS_NODE : "/mc/detections\n(DET not implemented)"
PFRONT .[#888888,dashed].> GCS_NODE : "/mc/perception/front/detections\n(PFRONT not implemented)"

' Gimbal video pipeline (Stream A, independent of vision pipeline and GCS MAVLink channel)
' — video-ingest/video-downlink not built yet, so this whole pipeline is design-only.
PFRONT .[#888888,dashed].> VMUX : "/mc/perception/front/detections\n/mc/perception/front/tracks\n(not built yet)"
VMUX .[#888888,dashed].> QGC : "RTSP/H.265 + metadata\nStream A :8555 (gimbal)\nStream B :8556 (downward)\n(not built yet)"
PFRONT .[#888888,dashed].> HEALTH : "(liveness heartbeat, not built yet)"
VMUX .[#888888,dashed].> HEALTH : "/mc/video/downlink_status\n/mc/video/down_downlink_status\n(not built yet)"

' Downward camera video pipeline (Stream B — additive, perception_down_node's
' detection role is unchanged; this is a new consumer of existing topics)
CAMNODE .[#888888,dashed].> VMUX : "/camera/image_raw\n(Stream B input, not built yet)"
DET .[#888888,dashed].> VMUX : "/mc/detections\n(Stream B metadata, not built yet)"

' Health → GCS + manager
HEALTH --> GCS_NODE : "/mc/health"
HEALTH --> EXEC : "/mc/fault (failsafe trigger)"

legend right
  | Color | Container |
  | <#A8CCEE> | fcc-bridge |
  | <#B8DCA8> | mavlink-router |
  | <#90C890> | gcs-comms |
  | <#90C890> | mission-orchestrator |
  | <#D8C8E8> | swarm-coord  [SCAFFOLD — not implemented] |
  | <#FFD090> | mission-exec (mission_manager_node real;\nsearch_planner_node scaffold) |
  | <#E0C8F8> | camera (real, deployed) |
  | <#DCC8F0> | vision  [SCAFFOLD — not implemented] |
  | <#E8E8E8> | video-ingest / video-downlink  [NOT YET BUILT — no container/unit exists;\nnodes themselves are also scaffolds] |
  | <#D0D0D0> | health-monitor |
  | <#C8D8F0> | Mission Orchestrator (another team's GCS-side app, not yet built) |
  | Dashed border/line | Either "not yet built" (no container/deployment) or\n"scaffold" (Node() constructor only, no pub/sub/timer logic) — see notes on each package |
endlegend

@enduml
