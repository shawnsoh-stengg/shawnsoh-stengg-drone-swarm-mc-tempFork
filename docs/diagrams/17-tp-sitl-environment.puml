@startuml 17-tp-sitl-environment
' ─────────────────────────────────────────────────────────────
' Diagram 17: SITL Test Environment Topology
' MC-TP-001 §3.2
' ─────────────────────────────────────────────────────────────

title "17 — SITL Test Environment Topology\nSoftware-In-The-Loop Network and Process Layout  ·  MC-TP-001 §3.2"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam shadowing false
skinparam RoundCorner 5

skinparam package {
  BorderThickness 2
  FontSize 10
  FontStyle bold
}

skinparam rectangle {
  BorderThickness 1.5
  FontSize 9
}

skinparam note {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

skinparam arrow {
  Color #3D5A80
  FontColor #2A4060
  FontSize 9
}

' ═══════════════════════════════════════════════════
' SITL HOST  (x86_64 Ubuntu 22.04 Desktop)
' ═══════════════════════════════════════════════════
package "SITL Host  ·  Ubuntu 22.04 x86_64  ·  192.168.10.50" as SITL_HOST #FFF0E0 {

  package "PX4 SITL Instance 1  (Drone 1)" as PX4_1 #FFE0C0 {
    rectangle "px4  (jmavsim / Gazebo)\nTCP:4560  · UDP:14540\nMAV_SYS_ID=1" as PX4_1A #FFD4A8
    rectangle "MicroXRCEAgent\nUDP:8888 (instance 1)\nbridges PX4 uORB ↔ ROS 2" as XRCE_1 #FFD4A8
  }

  package "PX4 SITL Instance 2  (Drone 2)" as PX4_2 #FFE0C0 {
    rectangle "px4  (jmavsim / Gazebo)\nTCP:4561  · UDP:14541\nMAV_SYS_ID=2" as PX4_2A #FFD4A8
    rectangle "MicroXRCEAgent\nUDP:8889 (instance 2)\nbridges PX4 uORB ↔ ROS 2" as XRCE_2 #FFD4A8
  }

  rectangle "Gazebo Garden\n3D physics simulation\nIMU · GPS · camera · collisions\nShared world for all instances" as GAZEBO #F4C88A

  rectangle "mock_gcs_node\n(Python / rclpy)\nSends MAVLink 2 to MC instances\nReceives MC_STATUS · MC_DETECTION\nRecords all GCS traffic for assertion" as MOCKGCS #C8E0A8

  rectangle "pytest test script\n(per TP-ST test case)\nOrchestrates: GCS commands · fault injection\nAsserts: phase transitions · topic rates · content\nRecords: latencies · fault times · resource usage" as PYTEST #B8DCA8
}

' ═══════════════════════════════════════════════════
' MC INSTANCE 1  (Docker stack — Drone 1)
' ═══════════════════════════════════════════════════
package "MC Instance 1  ·  Docker stack  ·  192.168.10.11" as MC1 #E4EEF8 {
  rectangle "drone-mc.target\nFCC_TRANSPORT=mavlink_udp\nSIMULATION_MODE=true\nDRONE_ID=1" as MC1_ENV #C0D8F0

  rectangle "fcc_bridge_node\n[MavlinkUdpBackend]\nUDP → 192.168.10.50:14540" as MC1_FCC #A8CCEE

  rectangle "mission_manager_node\nswarm_coordinator_node\nformation_controller_node\nsearch_planner_node\nhealth_monitor_node\ngcs_mavlink_node\nvisual_localisation_node\nperception_down_node" as MC1_NODES #B8D0E8

  rectangle "mock_camera_node\n(replaces CSI camera_node)\nreplays bags/camera_outdoor.bag\n1280×720 BGR8 ≥15 FPS" as MC1_CAM #D0E0F8

  rectangle "CycloneDDS\nDomain 0  ·  DRONE_ID=1" as MC1_DDS #C8D8F0
}

' ═══════════════════════════════════════════════════
' MC INSTANCE 2  (Docker stack — Drone 2)
' ═══════════════════════════════════════════════════
package "MC Instance 2  ·  Docker stack  ·  192.168.10.12" as MC2 #EEE4F8 {
  rectangle "drone-mc.target\nFCC_TRANSPORT=mavlink_udp\nSIMULATION_MODE=true\nDRONE_ID=2" as MC2_ENV #C8B0E8

  rectangle "fcc_bridge_node\n[MavlinkUdpBackend]\nUDP → 192.168.10.50:14541" as MC2_FCC #C0A0E0

  rectangle "mission_manager_node\nswarm_coordinator_node\nformation_controller_node\nsearch_planner_node\nhealth_monitor_node\ngcs_mavlink_node\nvisual_localisation_node\nperception_down_node" as MC2_NODES #C8B8E0

  rectangle "mock_camera_node\n(replays bags/camera_outdoor.bag)" as MC2_CAM #D8C8F0

  rectangle "CycloneDDS\nDomain 0  ·  DRONE_ID=2" as MC2_DDS #C8C0F0
}

' ═══════════════════════════════════════════════════
' CONNECTIONS
' ═══════════════════════════════════════════════════

' FCC SITL ↔ MC  (MAVLink UDP — FccBackend)
MC1_FCC <-[#E07000]-> PX4_1A : MAVLink 2 / UDP\n:14540 ↔ :14550
MC2_FCC <-[#E07000]-> PX4_2A : MAVLink 2 / UDP\n:14541 ↔ :14551

' GCS ↔ MC  (MAVLink 2/UDP — Channel B)
MOCKGCS <-[#208040]-> MC1_NODES : MAVLink 2 / UDP\n:14551/:14552 (Drone 1)
MOCKGCS <-[#208040]-> MC2_NODES : MAVLink 2 / UDP\n:14553/:14554 (Drone 2)

' Swarm peer-to-peer (UDP loopback)
MC1_NODES <-[#7030A0]-> MC2_NODES : Swarm Protocol / UDP\n192.168.10.11↔12\n:14900 hb · :14901 coord

' Camera mock → nodes
MC1_CAM -[#5050C0]-> MC1_NODES : /camera/image_raw\n/camera/camera_info  ≥15 FPS
MC2_CAM -[#5050C0]-> MC2_NODES : /camera/image_raw\n/camera/camera_info  ≥15 FPS

' Pytest control
PYTEST -[#208040]-> MOCKGCS : GCS commands + assertions
PYTEST -[#C02020]-> MC1_NODES : fault injection\n(iptables / docker kill)
PYTEST -[#C02020]-> MC2_NODES : fault injection

' Gazebo shared physics
GAZEBO -[#A08020]-> PX4_1A : sensor data (IMU · GPS · camera)
GAZEBO -[#A08020]-> PX4_2A : sensor data

' ═══════════════════════════════════════════════════
' NOTES
' ═══════════════════════════════════════════════════

note bottom of MC1
  CycloneDDS domain 0 is per-instance (DRONE_ID env var
  included in domain partition key), so Drone 1 and Drone 2
  internal topics do not cross-contaminate.
  Each stack runs in its own Docker bridge network segment.
end note

note bottom of SITL_HOST
  Network layout replicates production 192.168.10.x on loopback:
  SITL host acts as router via iptables NAT rules.
  Fault injection: iptables DROP on specific ports simulates link loss.
  docker kill targets specific containers to simulate node crashes.
end note

legend right
  | Line | Interface |
  | <#E07000> Orange  | FCC ↔ MC  (MAVLink UDP — SITL transport) |
  | <#208040> Green   | GCS ↔ MC  (MAVLink 2/UDP Channel B) |
  | <#7030A0> Purple  | MC ↔ MC Peer  (Swarm Protocol/UDP) |
  | <#5050C0> Blue    | Camera → MC  (ROS 2 topics) |
  | <#C02020> Red     | pytest fault injection  (iptables / docker) |
  | <#A08020> Olive   | Gazebo → PX4 SITL  (sensor simulation) |
endlegend

@enduml
