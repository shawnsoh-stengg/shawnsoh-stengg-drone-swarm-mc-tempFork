@startuml 10-sdd-fccbackend-class
' ─────────────────────────────────────────────────────────────
' Diagram 10: FccBackend Class Hierarchy
' SDD §3 — Transport-Agnostic FCC Abstraction
' MC-SDD-001
' ─────────────────────────────────────────────────────────────

title "10 — FccBackend Class Hierarchy\nTransport-Agnostic FCC Abstraction  ·  SDD §3"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam shadowing false
skinparam RoundCorner 4
skinparam ClassBorderThickness 1.5
skinparam ClassFontSize 10
skinparam ClassFontStyle bold
skinparam ClassAttributeFontSize 9
skinparam ClassBackgroundColor #F4F8FF
skinparam ClassBorderColor #3D5A80
skinparam ClassStereotypeFontSize 9
skinparam NoteBorderColor #C09030
skinparam NoteBackgroundColor #FFFAE8
skinparam NoteFontSize 9
skinparam ArrowColor #3D5A80
skinparam ArrowFontSize 9
skinparam ArrowFontColor #2A4060
skinparam PackageBorderColor #8AA8C8
skinparam PackageBackgroundColor #F0F4FA
skinparam PackageFontSize 10
skinparam PackageFontStyle bold

' ═══════════════════════════════════════════════════
' DATA TRANSFER OBJECTS
' ═══════════════════════════════════════════════════

package "Shared Data Types  (mc_msgs)" as TYPES #F0F6E8 {

  class VehicleState << struct >> #D8EED8 {
    + x, y, z : float          ' NED m
    + vx, vy, vz : float       ' m/s
    + xy_valid : bool
    + z_valid : bool
    + lat, lon : double        ' geodetic deg
    + alt_msl : float          ' m
    + q[4] : float             ' w,x,y,z
    + heading : float          ' rad
    + battery_remaining : float
    + arming_state : uint8_t
    + nav_state : uint8_t
    + fix_type : uint8_t       ' GNSS quality (TEST-002)
    + hdop, vdop : float
    + gnss_ok : bool
    + failure_flags : uint16_t
    + stamp : rclcpp::Time
  }

  class MissionItem << struct >> #D8EED8 {
    + seq : uint16_t           ' 0 = FORMATION_SLOT
    + frame : uint8_t          ' MAV_FRAME_GLOBAL_INT
    + command : uint16_t       ' MAV_CMD_NAV_WAYPOINT, ...
    + lat, lon : int32_t       ' 1e7 deg
    + alt : float              ' m MSL
    + acceptance_radius : float ' m
    + stamp : rclcpp::Time
  }

  class VisualOdometry << struct >> #D8EED8 {
    + position[3] : float      ' NED m
    + q[4] : float
    + velocity[3] : float
    + position_variance[3] : float
    + stamp : rclcpp::Time
  }

  class OffboardSetpoint << struct >> #D8EED8 {
    + x, y, z : float          ' NED m
    + yaw : float              ' rad, NED
  }
}

' ═══════════════════════════════════════════════════
' ABSTRACT BASE
' ═══════════════════════════════════════════════════

abstract class FccBackend #C0D8F0 {
  {abstract} + upload_mission(items : vector<MissionItem>) : bool
  {abstract} + update_mission_item(seq : uint16_t, item : MissionItem) : bool
  {abstract} + stream_offboard_setpoint(sp : OffboardSetpoint) : void
  {abstract} + send_command(cmd : uint32_t, params : float[7]) : void
  {abstract} + publish_visual_odometry(vo : VisualOdometry) : void
  {abstract} + get_vehicle_state() : VehicleState
  {abstract} + is_link_alive(timeout_s : double = 1.0) : bool
  + ~FccBackend()
}

' ═══════════════════════════════════════════════════
' CONCRETE IMPLEMENTATIONS
' ═══════════════════════════════════════════════════

class XrceDdsBackend #A8CCEE {
  ' uXRCE-DDS transport — production
  - node_ : rclcpp::Node*
  ' Subscriptions  /fmu/out/  (uXRCE-DDS)
  - sub_local_pos_
  - sub_global_pos_
  - sub_status_
  - sub_battery_
  - sub_attitude_
  - sub_odometry_
  - sub_imu_
  ' Publishers  /fmu/in/  (uXRCE-DDS)
  - pub_vehicle_command_
  - pub_visual_odometry_
  ' FCC-009: OFFBOARD stream, published together on each
  ' stream_offboard_setpoint() call — no internal buffering
  - pub_offboard_control_mode_
  - pub_trajectory_setpoint_
  ' Mission protocol — MAVLink 2/UDP :14555 (FCC_MISSION_PORT),
  ' always 192.168.12.x (not DDS; stock PX4 has no DDS-writable
  ' mission topic, IR-007). Protocol logic itself lives in the
  ' shared MissionProtocolClient below, not in this class.
  - mission_sock_fd_ : int
  - mission_client_ : unique_ptr<MissionProtocolClient>
  - state_mtx_ : std::mutex
  - state_ : VehicleState
  - last_fcc_msg_time_ : rclcpp::Time
  __
  - on_local_pos(msg) : void
  - on_global_pos(msg) : void
  - on_vehicle_status(msg) : void
  - on_battery(msg) : void
  - on_attitude(msg) : void
  - on_odometry(msg) : void
  - on_imu(msg) : void
  - touch_link_alive() : void
  - open_mission_socket() : int
}

class MavlinkUdpBackend #B8D4E8 {
  ' MAVLink UDP transport — SITL / fallback. One socket carries vehicle
  ' state, commands, AND the mission protocol (no separate DDS channel
  ' to fall back to in SITL) — unlike XrceDdsBackend's dedicated port.
  - node_ : rclcpp::Node*
  - sock_fd_ : int
  - recv_thread_ : std::thread
  - stop_ : std::atomic<bool>
  - socket_use_mtx_ : std::mutex
  ' Peer (PX4 SITL) is not a fixed address — learned dynamically via
  ' the first recvfrom(), same pattern as MAVSDK's udpin:// style
  - peer_mtx_ : std::mutex
  - peer_known_ : bool
  - peer_addr_ : sockaddr_in
  - mission_client_ : unique_ptr<MissionProtocolClient>
  - state_mtx_ : std::mutex
  - state_ : VehicleState
  - last_fcc_msg_time_ : rclcpp::Time
  __
  - recv_loop() : void
  - dispatch(msg) : void
  - handle_global_position_int(msg) : void
  - handle_attitude(msg) : void
  - handle_battery_status(msg) : void
  - handle_local_position_ned(msg) : void  ' TEST-002: x/y/z, NED
  - handle_heartbeat(msg) : void           ' TEST-002: arming_state
  - handle_gps_raw_int(msg) : void         ' TEST-002: gnss_ok/fix_type/hdop/vdop
  - note_peer(addr) : void
  - ensure_mission_client() : bool
}

' Not itself a FccBackend — a helper each concrete backend owns,
' driving the standard MAVLink mission protocol over a caller-owned
' UDP socket (ICD §3.3 "Mission Protocol"). Shared unmodified by both
' backends — XrceDdsBackend over its dedicated port 14555,
' MavlinkUdpBackend multiplexed over its single existing socket.
class MissionProtocolClient #E8E0F8 {
  - sock_fd_ : int
  - target_addr_ : sockaddr_in
  - system_id_ : uint8_t
  - component_id_ : uint8_t
  - seq_ : uint8_t  ' MAVLink frame sequence, wraps at 256
  - logger_ : rclcpp::Logger
  __
  + MissionProtocolClient(sock_fd, target_addr, system_id, component_id, logger)
  + upload_mission(items : vector<MissionItem>) : bool
  + update_mission_item(seq, item, timeout_s = 0.5) : bool
  - serve_single_item_request(item, timeout_s) : bool
  - send_mission_count(count) : void
  - send_mission_item_int(item) : void
  - send_mission_write_partial_list(start_seq, end_seq) : void
  - recv_frame(timeout_s, out_msg) : bool
}

' ═══════════════════════════════════════════════════
' FACTORY
' ═══════════════════════════════════════════════════

class make_fcc_backend << (F,#D8C0F0) factory >> #E8D8F8 {
  + make_fcc_backend(node : rclcpp::Node*) : unique_ptr<FccBackend>
  ' Reads SIMULATION_MODE env var (bool)
  '  true  → MavlinkUdpBackend
  '  false → XrceDdsBackend
  ' (FCC_TRANSPORT is a separate, XrceDdsBackend-internal env var —
  ' serial vs ethernet — not the class-selection switch)
}

' ═══════════════════════════════════════════════════
' OWNER NODE
' ═══════════════════════════════════════════════════

class FccBridgeNode << rclcpp::Node >> #D8E8F8 {
  ' ROS 2 executable/node name: fcc_bridge_node. Zero business logic —
  ' topic adapter + liveness monitoring + fault publication only
  ' (FCC-004/005/006/009). No /mc/fcc/imu or /mc/fcc/odometry relay
  ' exists yet — SDD §3.4 item 4, tracked separately, not built.
  - backend_ : unique_ptr<FccBackend>
  - link_timeout_s_ : double
  - link_was_alive_ : bool
  - pub_vehicle_state_  ' /mc/fcc/vehicle_state  ≥10 Hz
  - pub_fault_          ' /mc/fault  (FaultEvent, on FCC_LINK_LOST)
  - pub_mission_ack_    ' /mc/fcc/mission_ack  (FCC-006)
  - timer_cb_group_ : CallbackGroup
  - publish_timer_ : TimerBase
  - mission_cb_group_ : CallbackGroup   ' mission_upload + mission_item_update share this
  - command_cb_group_ : CallbackGroup   ' send_command + offboard_setpoint share this
  - sub_mission_upload_       ' /mc/fcc/mission_upload
  - sub_mission_item_update_  ' /mc/fcc/mission_item_update
  - sub_send_command_         ' /mc/fcc/send_command
  - sub_offboard_setpoint_    ' /mc/fcc/offboard_setpoint  (FCC-009)
  __
  + FccBridgeNode(options, backend = nullptr)  ' backend param: test seam only
  - on_publish_timer() : void
  - on_mission_upload(msg) : void
  - on_mission_item_update(msg) : void
  - on_offboard_setpoint(msg) : void
  - on_send_command(msg) : void
  - to_msg(state, link_alive) : mc_msgs::msg::VehicleState
  - {static} to_mission_item(msg) : MissionItem
  - publish_mission_ack(request_type, upload_id, seq, success) : void
}

' ═══════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════

FccBackend <|-- XrceDdsBackend
FccBackend <|-- MavlinkUdpBackend

make_fcc_backend ..> XrceDdsBackend    : <<creates>>
make_fcc_backend ..> MavlinkUdpBackend : <<creates>>

FccBridgeNode *--> FccBackend          : backend_\n(owns via unique_ptr)
FccBridgeNode ..>  make_fcc_backend    : calls at startup

XrceDdsBackend   *--> MissionProtocolClient : mission_client_\n(owns via unique_ptr)
MavlinkUdpBackend *--> MissionProtocolClient : mission_client_\n(owns via unique_ptr, lazily\nconstructed by ensure_mission_client())
MissionProtocolClient ..> MissionItem  : accepts/produces

FccBackend --> VehicleState       : returns (copy)
FccBackend --> MissionItem        : accepts
FccBackend --> VisualOdometry     : accepts
FccBackend --> OffboardSetpoint   : accepts

' ═══════════════════════════════════════════════════
' NOTES
' ═══════════════════════════════════════════════════

note top of FccBackend
  Abstract base — no state of its own; each
  concrete backend owns its own state_/state_mtx_/
  last_fcc_msg_time_. Application nodes never hold
  a reference to the concrete type. All MC nodes
  communicate via  /mc/fcc/*  topics published
  by  FccBridgeNode  —  not by calling backend
  methods directly.  [FR-016, IR-001]
end note

note right of XrceDdsBackend
  Production.
  ttyTHS1  @921600 baud  (primary)
  192.168.12.x  UDP:8888  (secondary)
  Micro XRCE-DDS Agent bridges
  ROS 2 ↔ PX4 uORB topic bus.
  All 7 subscribed topics updated
  into state_ under state_mtx_.
  ──────────────────────────────
  upload_mission()/update_mission_item()
  do NOT use DDS — mission_sock_fd_ is a
  separate MAVLink 2/UDP socket to
  192.168.12.31:14555, always active
  regardless of FCC_TRANSPORT.  [IR-007]
  ──────────────────────────────
  stream_offboard_setpoint() (FCC-009) DOES
  use DDS — publishes OffboardControlMode
  (position=true) + TrajectorySetpoint to
  /fmu/in/* on each call, one leg-conditional
  exception to the "MISSION mode only" rule
  above.  Velocity/accel/jerk NaN'd out per
  TrajectorySetpoint's own "NaN = uncontrolled"
  convention.  No DO_SET_MODE OFFBOARD here —
  mode entry stays in send_command(), called
  by mission_manager_node.  [SDD §4.1a/§5.3a]
end note

note right of MavlinkUdpBackend
  SITL / fallback.
  SIMULATION_MODE=true selects this
  implementation.  No code changes
  elsewhere in the system.  [SW-050]
  ──────────────────────────────
  Mission protocol logic is identical
  to XrceDdsBackend's (same shared
  MissionProtocolClient class), just
  multiplexed over sock_fd_ instead of
  a dedicated port — lazily constructed
  by ensure_mission_client() once the
  peer address is known.
  ──────────────────────────────
  stream_offboard_setpoint() (FCC-009) sends
  SET_POSITION_TARGET_LOCAL_NED over the same
  sock_fd_ — same peer_known_ drop-and-warn
  convention send_command() already uses for
  "no SITL peer yet."
end note

note bottom of make_fcc_backend
  Called once at  fcc_bridge_node  startup.
  Reads  FCC_TRANSPORT  env var from
  /etc/drone-mc/environment.
  Returns  unique_ptr<FccBackend>.
end note

@enduml
