@startuml 13-sdd-vo-pipeline
' ─────────────────────────────────────────────────────────────
' Diagram 13: Visual Odometry and Localisation Pipeline
' SDD §8 — visual_localisation_node
' MC-SDD-001
' ─────────────────────────────────────────────────────────────

title "13 — Visual Odometry Pipeline\nvisual_localisation_node  ·  SDD §8"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam shadowing false
skinparam RoundCorner 5

skinparam rectangle {
  BorderColor #3D5A80
  BorderThickness 1.5
  FontSize 10
  BackgroundColor #D8E8F8
}

skinparam component {
  BorderColor #3D5A80
  BorderThickness 1.5
  FontSize 10
  BackgroundColor #D8E8F8
}

skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #3D5A80
  BorderThickness 2
  FontSize 10
  FontStyle bold
}

skinparam note {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

skinparam arrow {
  Color #3D5A80
  FontColor #2A4060
  FontSize 9
}

' ═══════════════════════════════════════════════════
' INPUTS
' ═══════════════════════════════════════════════════

note as N_STATUS #FFE0E0
  <b>Status as of 2026-09-08: NOT YET IMPLEMENTED.</b>
  ws/src/vision/src/visual_localisation_node.cpp is still a 15-line
  scaffold — its own header says so directly: "Scaffold only — the
  FAST+ORB/KLT/5-point-RANSAC pipeline and GNSS handover logic land
  with the vision implementation work." This diagram is the SDD §8
  design to build against, not a description of current behaviour.
end note

package "Inputs" as INPUTS #F0F6E8 {
  rectangle "/camera/image_raw\nsensor_msgs/Image\nBGR8 · 1280×720 · ≥15 FPS\nframe_id=camera_optical" as CAM_IN #C8DCC0
  rectangle "/mc/fcc/imu\nsensor_combined (uXRCE-DDS)\ngyro_rad[3] (rad/s)\naccel_m_s2[3]\n≥100 Hz" as IMU_IN #C8DCC0
  rectangle "/mc/fcc/vehicle_state\nGNSS fix_type · eph · epv\nlat, lon, alt_msl\n≥5 Hz" as GNSS_IN #C8DCC0
}

' ═══════════════════════════════════════════════════
' VISUAL ODOMETRY PIPELINE (GPU-assisted on Jetson)
' ═══════════════════════════════════════════════════

package "Visual Odometry Pipeline  (CPU · Jetson Orin NX)" as VOPIPE #E4EEF8 {

  rectangle "Frame Buffer\n(sliding window, 10 keyframes)" as FRAMEBUF #B8CDE8

  rectangle "Feature Extraction\nFAST corner detector\n≥200 features per frame\nthreshold tuned per lighting" as FEAT #A8CCEE

  rectangle "Feature Tracking\nKLT Optical Flow\nframe-to-frame tracking\nmax 200 features tracked" as TRACK #A8CCEE

  rectangle "Essential Matrix Estimation\n5-point algorithm + RANSAC\ninlier threshold 2 px\nreturns R, t (up to scale)" as ESSEN #A8CCEE

  rectangle "Scale Recovery\n‖Δp_imu‖ / ‖Δp_vo‖\nsmoothed α=0.1 low-pass\nscale_factor: float" as SCALE #A8CCEE

  rectangle "Relative Pose Integration\naccumulate R,t chain over\nsliding window (10 frames)\ndrift bounded by window size" as POSE #A8CCEE
}

' ═══════════════════════════════════════════════════
' IMU PRE-INTEGRATION
' ═══════════════════════════════════════════════════

package "IMU Pre-Integration  (between keyframes t₀ → t₁)" as IMUINT #FFF0E0 {

  rectangle "Bias Estimation\nrandom-walk model\nbias_accel[3] · bias_gyro[3]\nupdated from GNSS when available" as BIAS #FFD4A8

  rectangle "Δp_imu = ∫∫(a_body − a_bias)dt²\nover [t₀, t₁]\nΔv_imu = ∫(a_body − a_bias)dt" as PREINT #FFD4A8
}

' ═══════════════════════════════════════════════════
' GNSS HANDOVER STATE MACHINE
' ═══════════════════════════════════════════════════

package "Localisation Mode Controller" as LMODE #F0E8F8 {

  rectangle "GNSS Quality Monitor\nfix_type ≥ 3  AND  hdop < 2.0\n3 consecutive good readings\n→ GNSS_PRIMARY" as GNSSMON #D8C0F0

  rectangle "LocalisationMode FSM\n─────────────────────\nGNSS_PRIMARY\n  → if GNSS lost: origin←fix, mode=VO\nVISUAL_ODOMETRY\n  → if GNSS recovered: re-init origin, mode=GNSS\n─────────────────────\nHysteresis: 3 readings before switch" as LFSM #C8B0E8
}

' ═══════════════════════════════════════════════════
' OUTPUTS
' ═══════════════════════════════════════════════════

package "Outputs" as OUTPUTS #F0F6E8 {
  rectangle "/mc/local_pose\ngeometry_msgs/PoseWithCovarianceStamped\nposition (NED m) · orientation (q)\ncovariance 6×6 (grows in VO mode)\n≥10 Hz" as LPOSE #C8DCC0

  rectangle "/mc/localisation_mode\nmc_msgs/LocalisationMode\nGNSS_PRIMARY | VISUAL_ODOMETRY\nevent-driven on mode change" as LMODEOUT #C8DCC0

  rectangle "/mc/fcc/visual_odometry\nvehicle_visual_odometry\n(published to FCC only in VO mode)\n≥10 Hz  [FR-052]" as VOOUT #C8DCC0
}

' ═══════════════════════════════════════════════════
' FLOW
' ═══════════════════════════════════════════════════

CAM_IN  --> FRAMEBUF    : raw frames (≥15 FPS)
FRAMEBUF --> FEAT       : keyframe selected\n(every N frames)
FEAT    --> TRACK       : feature point set
TRACK   --> ESSEN       : matched pairs (u₀,v₀)↔(u₁,v₁)
ESSEN   --> SCALE       : R, t (unit length)

IMU_IN  --> PREINT      : raw accel + gyro
BIAS    --> PREINT      : bias estimates
PREINT  --> SCALE       : ‖Δp_imu‖ (metric distance)

SCALE   --> POSE        : scaled Δt per frame pair
POSE    --> LPOSE       : integrated NED pose + covariance

GNSS_IN --> GNSSMON     : fix_type, eph, epv
GNSSMON --> LFSM        : quality OK / LOST
LFSM    --> LMODEOUT    : mode change event
LFSM    --> VOOUT       : gate: publish only in VO mode
POSE    --> VOOUT       : NED pose → visual odometry msg

LPOSE   --> OUTPUTS     : /mc/local_pose
GNSS_IN --> LPOSE       : in GNSS_PRIMARY mode:\n  override position from GNSS fix

' ═══════════════════════════════════════════════════
' NOTES
' ═══════════════════════════════════════════════════

note bottom of SCALE
  Scale factor recovered from IMU pre-integration.
  s = ‖Δp_imu‖ / ‖Δp_vo‖
  Smoothed (α=0.1) to suppress noise.
  Held constant when GNSS available (IMU biases updated).
end note

note bottom of LFSM
  On GNSS_PRIMARY → VISUAL_ODOMETRY:
    VO origin ← current GNSS fix
    Covariance starts at GNSS eph/epv
  On VISUAL_ODOMETRY → GNSS_PRIMARY:
    VO origin re-initialised from recovered fix
    Covariance reset to GNSS eph/epv
  [FR-051, FR-052]
end note

note right of LPOSE
  Covariance in VO mode:
  Grows proportional to time since last GNSS fix.
  Used by perception_down_node for geolocation uncertainty.
  Drift bound: ≤5 m/min with ≥200 tracked features.  [FR-053]
end note

@enduml
