@startuml 01-system-context
' ─────────────────────────────────────────────────────────────
' Diagram 01: System Context
' Swarm Search Drone — Mission Computer (AI MC)
' MC-SRS-001
' ─────────────────────────────────────────────────────────────

title "01 — System Context\nSwarm Search Drone · Mission Computer"

left to right direction

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 11
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam ArrowColor #4A6080
skinparam ArrowFontColor #4A6080
skinparam ArrowFontSize 10
skinparam RoundCorner 6
skinparam Padding 6

skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #3D5A80
  BorderThickness 2
  FontSize 11
  FontStyle bold
  FontColor #1C2334
}

skinparam rectangle {
  BackgroundColor #E8F0FA
  BorderColor #3D5A80
  BorderThickness 1
  FontSize 11
  FontColor #1C2334
}

' ── MANET MESH NETWORK ───────────────────────────────────────
cloud "MANET Mesh Network" as MANET_NW #E0E0E0

' ── GROUND CONTROL STATION ───────────────────────────────────
' "GCS" is two separate actors, not one (GCS-ZENOH-DESIGN-REVIEW.md):
' QGroundControl (vehicle telemetry/control, MAVLink, unchanged) and the
' Mission Orchestrator (mission plan library, Zenoh, proposal — GCS-004).
package "Ground Control Station" as GCS_PKG #D8EED8 {
  rectangle "QGroundControl\n192.168.10.10\n\nVehicle Telemetry/Control\nOperator Monitor" as GCS #B8DCBA

  rectangle "Mission Orchestrator\n(another team's app)\n\nMission Plan Library\nCreate · Update · Activate\n[proposal — GCS-004]" as ORCH #C8D8F0

  rectangle "Mesh Radio (Ground Unit)\n192.168.10.63" as GU #E0E0E0
}

' ── SWARM PEERS ──────────────────────────────────────────────
package "Swarm Peers  (192.168.10.12+)" as PEERS_PKG #F5ECF5 {
  rectangle "Peer MC #2\n192.168.10.12" as P2 #E8D8F0
  rectangle "Peer MC #3\n192.168.10.13" as P3 #E8D8F0

  rectangle "Mesh Radio (Air Unit)\n192.168.10.22" as AU2 #E0E0E0
  rectangle "Mesh Radio (Air Unit)\n192.168.10.23" as AU3 #E0E0E0
}

' ── AIRBORNE DRONE ───────────────────────────────────────────
package "Airborne Drone" as DRONE_PKG #E8F2FC {

  package "Mission Computer (MC)" as MC_PKG #CCDFF5 {
    rectangle "Jetson Orin NX 16GB\n192.168.10.11\n──────────────────\nROS 2 Humble · CycloneDDS (same-host)\nzenoh-bridge-dds (cross-host mesh)\nDocker Engine\ndrone-mc.target\n──────────────────\nC++17 application nodes\nAI inference (GPU)" as MC #A8CCEE
  }

  package "Flight Control Computer (FCC)" as FCC_PKG #FFECD8 {
    rectangle "Pixhawk 6X\n192.168.10.31\n──────────────────\nPX4 v1.14 · NuttX\nuORB topics\nMAVLink 2" as FCC #FFD4A8
  }

  rectangle "IMX219\nCSI Camera\n(downward, VIO +\nground detection)" as CAM #EDE0F8

  rectangle "Gimbal IP Camera\n192.168.10.200\n(front-facing,\nsearch & detection)" as GIMCAM #EDE0F8

  rectangle "Mission Protocol Socket\nMAVLink 2/UDP :14555\n192.168.12.31 (always ethernet)\nnot routed by mavlink-router" as MISSPROTO #F5ECF5

  rectangle "Mesh Radio (Air Unit)\n 192.168.10.2x" as AU1 #E0E0E0
}

' ── CONNECTIONS ──────────────────────────────────────────────

' MC ↔ FCC  (direct — not via MANET)
MC <-left-> FCC : "  uXRCE-DDS\n  ttyTHS1 (FCC: Telem2) serial\n"

' MC ↔ FCC mission protocol  (the one MAVLink exception on this link, IR-007)
MC .left.> MISSPROTO : "MAVLink-Mission Comm.\n 192.168.12.3x ethernet\n  MISSION_COUNT\n  MISSION_ITEM_INT\n  MISSION_ACK"
MISSPROTO .right.> FCC

' Cameras → MC
CAM -up-> MC : "  CSI\n  /camera/image_raw\n  ≥15 FPS"
GIMCAM -up-> MC : "  RTSP/H.265 :8554\n  (IFD-006, HIF-007,\n  shared switch)"

' MC ↔ MANET
MC <-up-> AU1 : "  MAVLink 2/UDP  →  GCS (MC mission channel)\n  Swarm heartbeat / coordination (UDP)\n  192.168.10.x"
MC .up.> AU1 : "  Zenoh mesh (zenoh-bridge-dds)\n  TCP :7447 — peer MCs (ZBD-001, done)\n  + Mission Orchestrator [proposal]"
MC -up-> AU1 : "  GCS Video Uplink (RTSP/H.265 + metadata)\n  Stream A :8555 (gimbal) · Stream B :8556 (downward)"

' GCS ↔ MANET
GCS <--> GU : "  MAVLink 2/UDP  →  FCC (Flight Telemetry ch.)\n  MAVLink 2/UDP  →  MC (separate ch.)\n  Mission upload · Commands · Telemetry"
ORCH .down.> GU : "  Zenoh session\n  TCP :7447\n  Mission plan CRUD\n  [proposal — GCS-004]"

' MANET Mesh Network
GU <-down-> MANET_NW : Mesh Network Datalink
MANET_NW <-up-> AU1
MANET_NW <-down-> AU2 : "Swarm protocol/UDP\n  Heartbeat · Voronoi · ISR"
MANET_NW <-down-> AU3 : "Swarm protocol/UDP"

' Peers ↔ MANET
P2 <-left-> AU2 
P3 <-left-> AU3

' FCC ↔ MANET (autopilot telemetry to GCS goes via AU)
FCC <-> AU1 : "  MAVLink 2/UDP\n  (PX4 - Flight Telemtry channel)"

legend right
  | Color | Subsystem |
  | <#A8CCEE> | Mission Computer (MC) |
  | <#FFD4A8> | Flight Controller (FCC) |
  | <#B8DCBA> | Ground Control Station (QGroundControl) |
  | <#C8D8F0> | Mission Orchestrator (another team's app, proposal) |
  | <#E8D8F0> | Swarm Peer MCs |
  | <#EDE0F8> | Onboard Sensors |
  | <#F5ECF5> | MC↔FCC Mission Protocol (MAVLink exception, IR-007) |
  | Dashed line | Proposed, not yet implemented (GCS-004) |
endlegend

@enduml
