@startuml 25-hid-network-topology
' ─────────────────────────────────────────────────────────────
' Diagram 25: Network Interface Topology — All IP Connections
' MC-HID-001 §4 / §6
' ─────────────────────────────────────────────────────────────

title "25 — Network Interface Topology\nIP Addressing · Subnets · Port Map  ·  MC-HID-001 §4 / §6"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam shadowing false
skinparam RoundCorner 5

skinparam package {
  BorderThickness 2
  FontSize 10
  FontStyle bold
}

skinparam rectangle {
  BorderThickness 1.5
  FontSize 9
}

skinparam note {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

skinparam arrow {
  Color #3D5A80
  FontColor #1C2334
  FontSize 9
}

' ═══════════════════════════════════════════════════
' SUBNET: 192.168.12.x  (Internal MC↔FCC)
' ═══════════════════════════════════════════════════

package "Internal Subnet  192.168.12.0/24\n(on-board Ethernet switch — not MANET-routed)" as INT_NET #FFF4E4 {

  rectangle "Jetson eth0\n192.168.12.1\n(HIF-002 internal address)\nListens: UDP:8888 (XRCE-DDS Agent)\nListens: UDP:14555 (mission protocol, always on)" as JET_INT #A8CCEE

  rectangle "Pixhawk 6X Ethernet\n192.168.12.2\n(HIF-002 FCC address)\nConnects: UDP:8888 (XRCE-DDS Client)\nConnects: UDP:14555 (mission protocol, always on)" as PX4_INT #FFD4A8

  rectangle "On-board Ethernet Switch\n100BASE-T\n(baseboard fabric — no ext. cable)" as INT_SW #D0D8E8
}

JET_INT <-[#208040,thickness=2]-> INT_SW : 100BASE-T\n(on-board trace)
PX4_INT <-[#208040,thickness=2]-> INT_SW : 100BASE-T\n(on-board trace)

note bottom of INT_NET
  HIF-002: Ethernet fallback for uXRCE-DDS.
  UDP:8888 only used when FCC_TRANSPORT=ethernet.
  Default DDS transport is HIF-001 (ttyTHS1 serial).
  UDP:14555 (mission protocol) is ALWAYS active here,
  regardless of FCC_TRANSPORT — stock PX4 has no
  DDS-writable mission topic (ICD IR-007).
  This subnet is NOT accessible from the MANET.
end note

' ═══════════════════════════════════════════════════
' SUBNET: 192.168.10.x  (MANET External)
' ═══════════════════════════════════════════════════

package "MANET Subnet  192.168.10.0/24\n(L2 bridge via MANET Air Units — all peers share this subnet)" as EXT_NET #E8F4E8 {

  rectangle "Jetson eth0\n192.168.10.11\n(HIF-004 external address)" as JET_EXT #A8CCEE

  rectangle "Pixhawk 6X\n192.168.10.31\n(GCS direct MAVLink)" as PX4_EXT #FFD4A8

  rectangle "MANET Air Unit\n(on-drone, gateway)\n192.168.10.1\nRJ45 → wireless mesh" as AU_DUT #C8E0C8

  rectangle "GCS Laptop\n192.168.10.10\nQGroundControl\nSends MAVLink 2/UDP" as GCS #B8DCA8

  rectangle "MANET Air Unit (GCS)\n192.168.10.x (GCS-side AU)" as AU_GCS #C8E0C8

  rectangle "Peer Drone MC #2\n192.168.10.12\nDRONE_ID=2" as PEER2 #D8C0F0

  rectangle "Peer Drone MC #3\n192.168.10.13\nDRONE_ID=3" as PEER3 #D8C0F0

  rectangle "Peer AU #2\n(Drone 2 Air Unit)" as AU2 #C8E0C8

  rectangle "Peer AU #3\n(Drone 3 Air Unit)" as AU3 #C8E0C8

  rectangle "Gimbal IP Camera\n192.168.10.200\n(HIF-007, shared switch)\nRTSP/H.265 :8554" as GIMCAM #EDE0F8
}

' ── Wired connections on drone assembly ──────────
JET_EXT <-[#208040,thickness=2]-> AU_DUT  : 1000BASE-T · Cat 5e · ≤ 3 m\nJ3 RJ45 (HIF-004)
PX4_EXT <-[#208040,dashed]-> AU_DUT       : (optional: FCC Ethernet\nvia baseboard switch)
JET_EXT <-[#20A070,thickness=2]-> GIMCAM  : 100BASE-TX · JST-GH→RJ45 ≤2m\nJ15 (HIF-007, shared switch)

' ── MANET wireless links ─────────────────────────
AU_DUT  <-[#408040,thickness=2,dashed]-> AU_GCS  : MANET mesh\n(wireless)
AU_DUT  <-[#408040,thickness=1,dashed]-> AU2      : MANET mesh
AU_DUT  <-[#408040,thickness=1,dashed]-> AU3      : MANET mesh

' ── GCS wired to its AU ──────────────────────────
GCS     <-[#208040]-> AU_GCS  : Ethernet

' ── Peer MCs to peer AUs ─────────────────────────
PEER2   <-[#208040]-> AU2
PEER3   <-[#208040]-> AU3

' ═══════════════════════════════════════════════════
' PORT MAP TABLE
' ═══════════════════════════════════════════════════

package "UDP Port Map  (on 192.168.10.x)" as PORTS #F4F8FF {
  rectangle "GCS → FCC  (Channel A)\nDst: 192.168.10.31:14550\nStandard PX4 MAVLink autopilot channel\nMC does NOT inject on this channel" as PA #F4EAD4

  rectangle "GCS → MC  (Channel B recv)\nDst: 192.168.10.11:14551\nMC_CMD_* commands · MISSION_COUNT\nHEARTBEAT · COMMAND_LONG" as PB1 #D4E8D4

  rectangle "MC → GCS  (Channel B send)\nDst: 192.168.10.10:14552\nMC_STATUS (50100)  ≥2 Hz\nMC_DETECTION (50101)  event\nMC_HEALTH (50103)  ≥1 Hz\nCOMMAND_ACK · STATUSTEXT" as PB2 #D4E8D4

  rectangle "Swarm Heartbeat\nSrc/Dst: .11↔.12↔.13 :14900\n1 Hz SWARM_HEARTBEAT\n40-byte binary protocol" as PSH #E8D4F0

  rectangle "Swarm Coordination\nSrc/Dst: .11↔.12↔.13 :14901\nISR_CANDIDATE · ISR_RESULT\nVORONOI_PROPOSAL · VORONOI_ACCEPT\nPEER_STATE" as PSC #E8D4F0

  rectangle "Gimbal Camera Source Stream\nMC (client) → .200:8554\nRTSP/H.265 · perception_front_node\n(IFD-006, HIF-007)" as PGIM #C8E8D8

  rectangle "GCS Video Uplink\nMC .11:8555 → GCS\nRTSP/H.265 + metadata · video_mux_node\nIndependent of Channel A/B  (IFD-007)" as PVID #A8D8C0
}

note bottom of PORTS
  mavlink-router v4 handles Channel B routing.
  It listens on :14551 and forwards to GCS :14552.
  Channel A traffic (port 14550) passes through
  the MANET transparently to the FCC — the MC
  does not inspect or modify it.
end note

' ═══════════════════════════════════════════════════
' NETPLAN CONFIG NOTE
' ═══════════════════════════════════════════════════

note right of JET_EXT
  Jetson eth0 carries two IP addresses
  simultaneously (Netplan):
    192.168.10.11 / 24  → MANET subnet
    192.168.12.1  / 24  → internal FCC subnet
  Same physical port, same NIC.
  Linux IP aliases handle the routing.
  ─────────────────────────────────
  The gimbal camera (192.168.10.200) is just
  another host on the 192.168.10.0/24 segment,
  reached through the SAME eth0/switch — it is
  NOT a second Jetson interface (no eth1).
end note

legend right
  | Line | Description |
  | <#208040><b>───</b> | Wired Ethernet (100/1000BASE-T) |
  | <#20A070><b>───</b> | Gimbal camera (shared switch, HIF-007) |
  | <#408040><b>- - -</b> | MANET wireless (L2 bridge) |
  | <#3D5A80><b>- - -</b> | Optional / fallback link |
endlegend

@enduml
