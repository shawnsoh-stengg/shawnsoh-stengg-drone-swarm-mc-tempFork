@startuml 16-tp-test-architecture
' ─────────────────────────────────────────────────────────────
' Diagram 16: Test Level Architecture and Gates
' MC-TP-001 §2
' ─────────────────────────────────────────────────────────────

title "16 — Test Level Architecture\nTest Pyramid · Tooling · Entry/Exit Gates  ·  MC-TP-001 §2"

skinparam BackgroundColor #FAFBFC
skinparam DefaultFontColor #1C2334
skinparam DefaultFontSize 10
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam shadowing false
skinparam RoundCorner 5

skinparam package {
  BorderThickness 2
  FontSize 10
  FontStyle bold
}

skinparam rectangle {
  BorderThickness 1.5
  FontSize 9
}

skinparam note {
  BackgroundColor #FFFAE8
  BorderColor #C09030
  FontSize 9
}

skinparam arrow {
  Color #3D5A80
  FontColor #2A4060
  FontSize 9
}

' ═══════════════════════════════════════════════════
' LEVEL 5 — Hardware-in-the-Loop
' ═══════════════════════════════════════════════════
package "TP-HW — Hardware-in-the-Loop  (Milestone M5, M6)" as HW #FFE8C0 {
  rectangle "Environment\nPhysical Jetson Orin NX + Pixhawk 6X\nBench PSU · GCS laptop · IMX219 camera\nttyTHS1 serial · 192.168.10.x LAN" as HW_ENV #FFD4A8
  rectangle "Scope\n6 tests: uXRCE-DDS latency · camera FPS\nTensorRT sustained load · serial reliability\nboot time · full smoke suite on DUT" as HW_SCOPE #FFD4A8
  rectangle "Tools\nManual execution · rclpy observer scripts\ntegrastats · /proc · wireshark" as HW_TOOLS #FFD4A8
}

' ═══════════════════════════════════════════════════
' LEVEL 4 — SITL System Tests
' ═══════════════════════════════════════════════════
package "TP-ST — SITL System Tests  (M3 partial, M4 full, nightly CI)" as ST #D8EED8 {
  rectangle "Environment\nPX4 SITL + Gazebo (x86_64 host)\nMC Docker stack: SIMULATION_MODE=true\n2–3 MC instances on loopback LAN\nQGroundControl / mock_gcs_node" as ST_ENV #B8DCA8
  rectangle "Scope\n12 tests: nominal 2-drone mission · GCS loss HOLD\nbattery RTL · executor crash · peer loss re-partition\nFCC comms loss · mission upload · detection geolocation\nVO mode · ISR failover · telemetry · resource usage" as ST_SCOPE #B8DCA8
  rectangle "Tools\npytest + rclpy assertions\niptables (link injection) · docker kill (fault injection)\nros2 topic echo / hz / delay" as ST_TOOLS #B8DCA8
}

' ═══════════════════════════════════════════════════
' LEVEL 3 — Node Integration Tests
' ═══════════════════════════════════════════════════
package "TP-NI — Node Integration Tests  (M2+, every PR)" as NI #D8E8F8 {
  rectangle "Environment\nUbuntu 22.04 aarch64 (DUT) or cross-build CI\nROS 2 Humble · CycloneDDS domain 0\nMock nodes replace hardware-facing nodes" as NI_ENV #B8CDE8
  rectangle "Scope\n16 tests per-node: pub/sub rates · content accuracy\nlink loss fault · peer liveness · path generation\ndecoding · watchdog · inference latency · GCS encoding" as NI_SCOPE #B8CDE8
  rectangle "Tools\nlaunch_testing + pytest + rclpy\nros2 bag play (mock data) · ROS 2 param override" as NI_TOOLS #B8CDE8
}

' ═══════════════════════════════════════════════════
' LEVEL 2 — Unit Tests
' ═══════════════════════════════════════════════════
package "TP-UT — Unit Tests  (M2+, every PR)" as UT #E8D8F8 {
  rectangle "Environment\nNative build host · no ROS 2 runtime required\nIndividual package under test" as UT_ENV #D0B8F0
  rectangle "Scope\n18 gtest cases: ISR scoring · tie-break\nboustrophedon row count · nearest start · timing\nVoronoi validity · consensus mismatch · PD output\nsaturation · guard rejection · GCS bypass\ngeolocation ray-cast · health timeouts · battery RTL\nVO scale recovery" as UT_SCOPE #D0B8F0
  rectangle "Tools\ngtest · colcon test · gcovr (coverage report)" as UT_TOOLS #D0B8F0
}

' ═══════════════════════════════════════════════════
' LEVEL 1 — Smoke Tests
' ═══════════════════════════════════════════════════
package "TP-SM — Deployment Smoke Tests  (M1+, after each install script)" as SM #F0E8D8 {
  rectangle "Environment\nFreshly installed DUT or Docker image\nNo application nodes required" as SM_ENV #E0D0B8
  rectangle "Scope\n10 scripts: OS/kernel · JetPack/CUDA · Docker/cgroups\nROS 2/CycloneDDS · colcon workspace · mavlink-router\nXRCE-DDS agent · CSI camera pipeline · systemd services · networking" as SM_SCOPE #E0D0B8
  rectangle "Tools\nBash scripts · exit code pass/fail\nCheck: ldconfig · ros2 pkg list · systemctl is-active · ping" as SM_TOOLS #E0D0B8
}

' ═══════════════════════════════════════════════════
' GATES (vertical progression)
' ═══════════════════════════════════════════════════

SM_ENV -[hidden]down- UT_ENV
UT_ENV -[hidden]down- NI_ENV
NI_ENV -[hidden]down- ST_ENV
ST_ENV -[hidden]down- HW_ENV

rectangle "Gate SM→UT\nAll 10 smoke scripts pass\nZero FAIL lines" as G1 #FAFBFC
rectangle "Gate UT→NI\nAll 18 gtest cases pass\nCode coverage ≥ 80% per algorithm module" as G2 #FAFBFC
rectangle "Gate NI→ST\nAll 16 NI tests pass\nZero topic-rate failures" as G3 #FAFBFC
rectangle "Gate ST→HW\nAll 12 SITL tests pass\nZero S1/S2 defects open" as G4 #FAFBFC

SM -[#D08000]-> G1
G1 -[#D08000]-> UT
UT -[#D08000]-> G2
G2 -[#D08000]-> NI
NI -[#D08000]-> G3
G3 -[#D08000]-> ST
ST -[#D08000]-> G4
G4 -[#D08000]-> HW

' ═══════════════════════════════════════════════════
' MILESTONE ALIGNMENT
' ═══════════════════════════════════════════════════

note right of SM
  M1 (month 1): TP-SM-001–005
  M2 (month 2): TP-SM-006–010
end note

note right of UT
  M2 (month 2): all TP-UT
  CI: every pull request
end note

note right of NI
  M2 (month 2): TP-NI-001–007
  M4 (month 4): TP-NI-001–016
  CI: every pull request
end note

note right of ST
  M3 (month 3): TP-ST-001,003,006,007
  M4 (month 4): full suite (TP-ST-001–012)
  Nightly CI: TP-ST-001,002,003,006,007
end note

note right of HW
  M5 (month 5): TP-HW-001–006
  M6 (month 6): full regression repeat
  Manual execution with two-engineer team
end note

@enduml
